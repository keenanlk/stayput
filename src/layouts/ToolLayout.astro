---
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import ToolCard from '../components/ToolCard.astro';
import UploadVsLocal from '../components/UploadVsLocal.astro';
import { tools, toolPath, type Tool } from '../data/tools';
import { pairs } from '../data/pairs';
import { presets } from '../data/presets';
import { guidesFor } from '../data/guides';
import { engineFor } from '../data/engine';
import { nextSteps } from '../data/next-steps';
import { inline } from '../lib/inline';

interface Props {
  tool: Tool;
  /** Optional explanatory paragraphs shown above "How it works" (format-pair pages). */
  intro?: string[];
  /** Which engine copy to use when the page is a preset of another tool. */
  engineSlug?: string;
  /** Slug of the tool whose script runs this page (landing pages). */
  base?: string;
}
const { tool, intro = [], engineSlug, base } = Astro.props;
const path = toolPath(tool);
const url = new URL(path, Astro.site).toString();
const engine = engineFor(engineSlug ?? tool.slug);
// The tool this page runs first (on landing pages), then its neighbours in the category, wrapping around,
// so every tool is linked from several pages rather than only the first four in the list.
const sameCategory = tools.filter((t) => t.category === tool.category);
const home = sameCategory.findIndex((t) => t.slug === (base ?? tool.slug));
// A stable per-page number, so pages sharing a base tool start their link lists at different places
// and every sibling page gets linked from somewhere, not only the first few in each list.
const spin = [...tool.slug].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
const offset = base && base !== tool.slug ? spin % sameCategory.length : 0;
const neighbours = sameCategory.map((_, i) => sameCategory[(home + 1 + offset + i) % sameCategory.length]!).filter((t) => t.slug !== tool.slug);
const baseTool = base ? tools.find((t) => t.slug === base) : undefined;
const related = [...(baseTool ? [baseTool] : []), ...neighbours.filter((t) => t !== baseTool)].slice(0, 4);
const isPair = path.startsWith('/') && !path.startsWith('/tools/');
// On a pair page, list the pairs sharing its source or target format first (JFIF to JPG shows JFIF to PNG).
const [fromExt, toExt] = isPair ? tool.slug.split('-to-') : [];
const shares = (slug: string) => Number(slug.startsWith(`${fromExt}-to-`)) + Number(slug.endsWith(`-to-${toExt}`));
// Format words in this page's slug ("ogg", "mp3" for /ogg-to-mp3), so sibling pages about the same formats link each other.
const formatWords = new Set(tool.slug.includes('-to-') ? tool.slug.split('-to-').map((part) => part.split('-').pop()!) : []);
const sharesFormat = (slug: string) => (slug.includes('-to-') ? slug.split('-to-').filter((part) => formatWords.has(part.split('-').pop()!)).length : 0);
// Image pages list the format pairs; any other page lists only the pairs sharing a format with it (WebP to PDF shows WebP to PNG).
const conversions = pairs
  .filter((p) => p.slug !== tool.slug && (tool.category === 'images' || sharesFormat(p.slug) > 0))
  .sort((a, b) => shares(b.slug) - shares(a.slug) || sharesFormat(b.slug) - sharesFormat(a.slug))
  .slice(0, 10);
// Landing pages that are presets of tools in this category, so "JPG to PDF" is reachable from the PDF tools.
// Presets of the same tool come first, then those sharing a format with this page.
const presetScore = (p: (typeof presets)[number]) => 2 * Number(p.base === (base ?? tool.slug)) + sharesFormat(p.slug);
// Ties are broken by rotating from a per-page start, so each page shows a different dozen.
const inScope = presets.filter((p) => p.slug !== tool.slug && (tools.find((t) => t.slug === p.base)?.category === tool.category || sharesFormat(p.slug) > 0));
const turn = (i: number) => (i - (spin % Math.max(1, inScope.length)) + inScope.length) % Math.max(1, inScope.length);
const presetLinks = inScope
  .map((p, i) => ({ p, i: turn(i) }))
  .sort((a, b) => presetScore(b.p) - presetScore(a.p) || a.i - b.i)
  .map(({ p }) => p)
  .slice(0, 12);
// File labels for the upload-vs-local diagram: the format pair when the slug names one, else the category's usual file.
const labels: Record<string, string> = { jpg: 'JPG', jpeg: 'JPG', png: 'PNG', webp: 'WebP', heic: 'HEIC', avif: 'AVIF', svg: 'SVG', jxl: 'JXL', jfif: 'JFIF', gif: 'GIF', ico: 'ICO', bmp: 'BMP', tiff: 'TIFF', pdf: 'PDF', mp4: 'MP4', mov: 'MOV', mp3: 'MP3', m4a: 'M4A', wav: 'WAV', text: 'TXT', word: 'DOCX', image: 'Photo', picture: 'Photo', screenshot: 'PNG', video: 'Video' };
const fallback = tool.category === 'pdf' ? 'PDF' : tool.category === 'media' ? 'Video' : 'Photo';
const [slugFrom, slugTo] = tool.slug.split('-to-').map((part) => labels[part.split('-').pop() ?? '']);
const diagFrom = slugFrom ?? fallback;
const diagTo = tool.slug.includes('-to-') ? (slugTo ?? diagFrom) : diagFrom;
const next = (nextSteps[base ?? tool.slug] ?? []).map((s) => tools.find((t) => t.slug === s)).filter((t): t is Tool => !!t);
// Guides whose main tool is this page come first, then those whose main tool is the base tool, then the rest.
const guides0 = guidesFor([tool.slug, base ?? tool.slug]);
const guideScore = (g: (typeof guides0)[number]) => 2 * Number(g.tools[0] === tool.slug) + Number(g.tools[0] === (base ?? tool.slug)) + Number(g.tools.includes(tool.slug));
const guides = guides0
  .map((g, i) => ({ g, i: (i - (spin % Math.max(1, guides0.length)) + guides0.length) % Math.max(1, guides0.length) }))
  .sort((a, b) => guideScore(b.g) - guideScore(a.g) || a.i - b.i)
  .map(({ g }) => g)
  .slice(0, 5);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${tool.name} | Stayput`,
    url,
    description: tool.description,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires a modern browser with WebAssembly',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    isAccessibleForFree: true,
    license: 'https://opensource.org/licenses/MIT',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: tool.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Stayput', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: tool.name, item: url },
    ],
  },
];
---
<Base title={tool.title} description={tool.description} jsonLd={jsonLd} ogImage={`/og/${tool.slug}.png`}>
  <section class="tool-hero wrap">
    <h1>{tool.heading}</h1>
    <p class="tagline">{tool.tagline}</p>
    <ul class="facts">
      <li><Icon name="shield" /> Nothing is uploaded</li>
      <li><Icon name="offline" /> Works offline</li>
      <li><Icon name="open" /> Open source</li>
      <li><Icon name="check" /> No limits, no watermark</li>
    </ul>
  </section>

  <section class="wrap">
    <div class="tool-panel" id="tool" data-slug={tool.slug} data-base={base} data-multiple={String(tool.multiple)}>
      <div class="dropzone" id="drop" tabindex="0" role="button" aria-describedby="drop-hint">
        <Icon name="upload" />
        <strong>{tool.dropLabel}</strong>
        <span id="drop-hint">or click to choose {tool.multiple ? 'files' : 'a file'}. {tool.multiple ? 'Batches welcome.' : ''}</span>
      </div>
      <input class="visually-hidden" id="file-input" type="file" accept={tool.accept} multiple={tool.multiple} tabindex="-1" aria-hidden="true" />
      <ul class="file-list" id="file-list" aria-live="polite" aria-label="Selected files"></ul>
      <slot name="panel" />
      <div class="options" id="options">
        <slot name="options" />
      </div>
      <!-- Pinned to the bottom of the screen once a file is in, so Run is never scrolled out of reach. -->
      <div class="run-dock" id="run-dock">
        <p class="run-hint" id="run-hint" aria-live="polite" hidden></p>
        <div class="run-row">
          <button class="btn btn-primary btn-lg" id="run" type="button" disabled>{tool.action}</button>
          <button class="btn btn-ghost" id="clear" type="button" hidden>Clear</button>
          <div class="progress" id="progress" aria-live="polite">
            <span class="text" id="progress-text">Working…</span>
            <div class="bar" aria-hidden="true"><i id="progress-bar"></i></div>
          </div>
        </div>
        <div class="error" id="error" role="alert"></div>
      </div>
      <div class="results" id="results" aria-live="polite">
        <div class="results-head">
          <h2 id="results-title">Done</h2>
          <div class="field-row">
            <button class="btn btn-sm" id="download-all" type="button" hidden>Download all as zip</button>
          </div>
        </div>
        <div id="results-list" class="file-list"></div>
        {next.length > 0 && (
          <nav class="next-steps" id="next-steps" aria-label="Next step" hidden>
            <span class="muted small">Next step, also on your device:</span>
            <ul class="chips">{next.map((t) => <li><a href={toolPath(t)} data-to={t.slug}>{t.name}</a></li>)}</ul>
          </nav>
        )}
      </div>
      <div class="install" id="install" hidden role="region" aria-label="Install Stayput">
        <div>
          <strong>Keep Stayput a tap away.</strong>
          <span>Install it as an app. It works offline and takes no space worth mentioning.</span>
        </div>
        <div class="field-row">
          <button class="btn btn-sm btn-primary" id="install-yes" type="button">Install</button>
          <button class="btn btn-sm btn-ghost" id="install-no" type="button">Not now</button>
        </div>
      </div>
      <details class="netproof" id="netproof" hidden>
        <summary><Icon name="eye" /> <span>Open the network tab. Your files never appear in it.</span></summary>
        <p id="netproof-summary" class="muted">Add files and run the tool to see every request this tab makes.</p>
        <ul id="netproof-list" class="netproof-list"></ul>
      </details>
      <p class="privacy-note"><Icon name="shield" /><span>Your files are processed on this device and never sent to a server. Reload the page to clear everything from memory.</span></p>
    </div>
  </section>

  {intro.length > 0 && (
    <section class="wrap section prose-wide">
      {intro.map((p) => (/\[|\*\*/.test(p) ? <p set:html={inline(p)} /> : <p>{p}</p>))}
    </section>
  )}

  <section class="wrap section split">
    <h2>How it works</h2>
    <ol class="steps">{tool.steps.map((s) => <li>{s}</li>)}</ol>
  </section>

  <section class="wrap section split">
    <div>
      <h2>In your browser, not on a server</h2>
      <UploadVsLocal from={diagFrom} to={diagTo} />
    </div>
    <div class="engine">
      <p>{engine.how}</p>
      <p class="versus"><strong>Compared with upload-based tools:</strong> {engine.versus}</p>
      <p class="verify"><strong>Verify it yourself.</strong> Load this page, turn off Wi-Fi or switch to airplane mode, and run the tool. Or open your browser's developer tools (F12, or Cmd-Option-I on a Mac), pick the Network tab, and watch it while you convert. The panel above does the same count for you.</p>
    </div>
  </section>

  <section class="wrap section split">
    <h2>Questions</h2>
    <div class="faq">
      {tool.faq.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="wrap section split">
    <h2>More {tool.category === 'pdf' ? 'PDF' : tool.category === 'media' ? 'video and audio' : 'image'} tools</h2>
    <div class="tool-grid">{related.map((t) => <ToolCard tool={t} />)}</div>
  </section>

  {(conversions.length > 0 || presetLinks.length > 0) && (
    <section class="wrap section split">
      <h2>{isPair ? 'Other conversions' : 'Popular conversions'}</h2>
      <ul class="chips">
        {conversions.map((p) => <li><a href={`/${p.slug}`}>{p.from} to {p.to}</a></li>)}
        {presetLinks.map((p) => <li><a href={`/${p.slug}`}>{p.name}</a></li>)}
      </ul>
    </section>
  )}

  {guides.length > 0 && (
    <section class="wrap section split">
      <h2>Guides</h2>
      <ul class="guide-list">
        {guides.map((g) => <li><a href={`/guides/${g.slug}`}>{g.heading}</a><span class="muted">{g.dek}</span></li>)}
      </ul>
    </section>
  )}
</Base>
