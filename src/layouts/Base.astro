---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteVerification } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** JSON-LD objects to embed. */
  jsonLd?: object[];
  ogType?: string;
  /** Path of a 1200x630 social image. Defaults to the site-wide one. */
  ogImage?: string;
  /** Keep the page out of search results (404). */
  noindex?: boolean;
}
const { title, description, jsonLd = [], ogType = 'website', ogImage: ogPath = '/og.png', noindex = false } = Astro.props;
// Astro builds `format: 'file'` pages as /x.html; the served URL is /x.
const cleanPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonical = new URL(cleanPath, Astro.site);
const ogImage = new URL(ogPath, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {siteVerification.google && <meta name="google-site-verification" content={siteVerification.google} />}
    {siteVerification.bing && <meta name="msvalidate.01" content={siteVerification.bing} />}
    <meta name="theme-color" content="#1f6f5f" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121517" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Stayput" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script src="/register-sw.js" defer></script>
    <!-- Umami, self-hosted, cookie-free, loaded by src/lib/analytics.ts (skipped for automated browsers and opted-out owners). Records page views and the anonymous events listed there; never file names or contents. -->
    <script>
      import { loadAnalytics, trackPageContext } from '../lib/analytics';
      loadAnalytics();
      trackPageContext();
    </script>
  </body>
</html>
