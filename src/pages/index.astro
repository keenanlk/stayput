---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import ConversionMap from '../components/ConversionMap.astro';
import { tools, categories } from '../data/tools';
import { conversions, popularConversions, popularTools } from '../data/hubs';
import { guides } from '../data/guides';
import { profiles } from '../data/site';

// Short column headings so the three tool columns line up on one line.
const shortLabel = { images: 'Images', pdf: 'PDFs and files', media: 'Video and audio' };

const title = 'Stayput: Free File Tools That Never Upload Your Files';
const description =
  'Convert HEIC to JPG, merge and compress PDFs, shrink images and edit video, all inside your browser. No uploads, no limits, no watermarks. Open source.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Stayput',
    url: Astro.site?.toString(),
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Stayput',
    url: Astro.site?.toString(),
    logo: new URL('/icons/icon-512.png', Astro.site).toString(),
    email: 'hello@stayput.dev',
    sameAs: profiles,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: tools.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t.name,
      url: new URL(`/tools/${t.slug}`, Astro.site).toString(),
    })),
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>Your files stay put.</h1>
        <p class="lede">
          Convert, compress and edit images, PDFs, video and audio right here in your browser. Nothing is uploaded, nothing is capped, nothing is watermarked. It even works with the Wi-Fi off.
        </p>
        <div class="hero-actions">
          <a class="btn btn-invert btn-lg" href="/tools/heic-to-jpg">Convert a HEIC photo</a>
          <a class="hero-link" href="#tools">See all {tools.length} tools</a>
        </div>
      </div>
      <figure>
        <div class="devtools" role="img" aria-label="A browser network panel after converting photos: requests for the site's code and the decoder, then one small anonymous usage-count request. None of them carry the photos.">
          <div class="tabs"><span>Elements</span><span>Console</span><span class="on">Network</span><span>Application</span></div>
          <div class="rows">
            <div class="row head"><span>Name</span><span>Status</span><span>Size</span></div>
            <div class="row"><span>heic-to-jpg</span><span class="ok">200</span><span>9.1 kB</span></div>
            <div class="row"><span>heic-to-jpg.a8f3.js</span><span class="ok">200</span><span>31 kB</span></div>
            <div class="row"><span>heic-to.min.js (decoder)</span><span class="ok">200</span><span>1.6 MB</span></div>
            <div class="drop">IMG_4021.HEIC, IMG_4022.HEIC, IMG_4023.HEIC added</div>
            <div class="row"><span>e (usage count)</span><span class="ok">200</span><span>0.3 kB</span></div>
            <div class="empty"><b>No</b> request carried your photos.</div>
          </div>
        </div>
        <figcaption>What your browser's Network tab shows while three iPhone photos convert: the page and its code load, then one small anonymous usage-count request. No request carries your photos. Press F12 and try it.</figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap popular" id="tools" aria-labelledby="popular-h">
    <div class="index-head">
      <h2 id="popular-h">Most used</h2>
      <p>The tools people open first. All {tools.length} are listed below.</p>
    </div>
    <div class="tool-grid">{popularTools.map((t) => <ToolCard tool={t} />)}</div>
  </section>

  <div class="wrap index" aria-label={`All ${tools.length} tools`}>
    {categories.map((c) => {
      const list = tools.filter((t) => t.category === c.id);
      return (
        <section id={`${c.id === 'images' ? 'image' : c.id}-tools`} aria-labelledby={`${c.id}-h`}>
          <div class="index-head">
            <h2 id={`${c.id}-h`}>{shortLabel[c.id]} <span class="count">{list.length}</span></h2>
            <p>{c.blurb}</p>
          </div>
          <div class="tool-grid">{list.map((t) => <ToolCard tool={t} compact />)}</div>
        </section>
      );
    })}
  </div>

  <section class="wrap section split" aria-labelledby="spec-h">
    <div class="spec-intro">
      <h2 id="spec-h">Open the network tab. Your files never appear in it.</h2>
      <p style="margin-top:16px">Every tool here is JavaScript and WebAssembly running in your tab. There is no server that could receive your files, so none does. You will see a small anonymous usage-count request; it carries a tool name and a size bucket, never your file.</p>
      <p>Every tool page also counts its own requests after you add files and shows you the list, so you do not have to take our word for it.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/tools/heic-to-jpg">Try it with a photo</a>
        <a class="btn" href="https://github.com/keenanlk/stayput" rel="noopener">Read the source</a>
      </div>
    </div>
    <dl class="spec-sheet">
      <div><dt>Uploads</dt><dd><b>None.</b> The site is static files; every conversion runs in your tab.</dd></div>
      <div><dt>Limits</dt><dd><b>None.</b> No file size caps, no "two tasks per hour". Batch a hundred photos if your device can hold them.</dd></div>
      <div><dt>Account</dt><dd><b>None.</b> No sign-up wall, no watermark.</dd></div>
      <div><dt>Offline</dt><dd><b>Yes.</b> Open a tool once and it is cached. Install it as an app from your browser menu to keep it a tap away.</dd></div>
      <div><dt>Tracking</dt><dd>An anonymous, cookie-free page count. Never file names or contents.</dd></div>
      <div><dt>Source</dt><dd>MIT licensed and <a href="https://github.com/keenanlk/stayput" rel="noopener">on GitHub</a>. Read the code, report a bug, or host your own copy.</dd></div>
    </dl>
  </section>

  <section class="wrap section split" aria-labelledby="conv-h">
    <div class="conv-intro">
      <h2 id="conv-h">Popular conversions</h2>
      <p class="muted">{conversions.length} conversions, each with its own page. Every one runs in this tab.</p>
      <ConversionMap />
    </div>
    <div>
      <ul class="chips">{popularConversions.map((c) => <li><a href={`/${c.slug}`}>{c.label}</a></li>)}</ul>
      <p class="more-link"><a href="/conversions">See all {conversions.length} conversions</a></p>
    </div>
  </section>

  <section class="wrap section split" aria-labelledby="guides-h">
    <div>
      <h2 id="guides-h">Guides</h2>
      <p class="muted" style="margin-top:12px">Straight answers to the questions behind the tools. <a href="/guides">All guides</a>.</p>
    </div>
    <ul class="guide-list guide-grid">{guides.slice(0, 6).map((g) => <li><a href={`/guides/${g.slug}`}>{g.heading}</a><span class="muted">{g.dek}</span></li>)}</ul>
  </section>
</Base>
