---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools, categories } from '../data/tools';
import { pairs } from '../data/pairs';

const title = 'Stayput: Free File Tools That Never Upload Your Files';
const description =
  'Convert HEIC to JPG, merge and compress PDFs, shrink images and strip EXIF data, all inside your browser. No uploads, no limits, no watermarks, works offline. Open source.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Stayput',
    url: Astro.site?.toString(),
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: tools.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t.name,
      url: new URL(`/tools/${t.slug}`, Astro.site).toString(),
    })),
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="home-hero wrap">
    <h1>Your files stay put.</h1>
    <p class="lede">
      Convert, compress and clean images and PDFs right here in your browser. Nothing is uploaded, nothing is capped, nothing is watermarked. It even works with the Wi-Fi off.
    </p>
    <div class="badges">
      <span class="badge"><Icon name="shield" /> Nothing is uploaded</span>
      <span class="badge"><Icon name="offline" /> Works offline</span>
      <span class="badge"><Icon name="open" /> Open source (MIT)</span>
      <span class="badge"><Icon name="check" /> Free, no account</span>
    </div>
  </section>

  {categories.map((c) => (
    <section class="wrap section" id={`${c.id === 'images' ? 'image' : 'pdf'}-tools`} style="margin-top:32px">
      <h2>{c.label}</h2>
      <p class="muted" style="margin-bottom:16px">{c.blurb}</p>
      <div class="tool-grid">{tools.filter((t) => t.category === c.id).map((t) => <ToolCard tool={t} />)}</div>
    </section>
  ))}

  <section class="wrap">
    <div class="hook">
      <div>
        <h2>Open the network tab. It stays empty.</h2>
        <p>Every tool here is JavaScript and WebAssembly running in your tab. There is no server that could receive your files, so none does. Press F12, pick Network, drop a file, and watch: code and one anonymous page count, never your file.</p>
        <p>Every tool page also counts its own requests after you add files and shows you the list, so you do not have to take our word for it.</p>
        <div class="actions">
          <a class="btn btn-primary" href="/tools/heic-to-jpg">Try it with a photo</a>
          <a class="btn" href="https://github.com/keenanlk/stayput" rel="noopener">Read the source</a>
        </div>
      </div>
      <div class="devtools" role="img" aria-label="A browser network panel after converting photos: requests for the site's code and the decoder, then no requests at all once the photos were added.">
        <div class="tabs"><span>Elements</span><span>Console</span><span class="on">Network</span><span>Application</span></div>
        <div class="rows">
          <div class="row head"><span>Name</span><span>Status</span><span>Size</span></div>
          <div class="row"><span>heic-to-jpg</span><span class="ok">200</span><span>9.1 kB</span></div>
          <div class="row"><span>heic-to-jpg.a8f3.js</span><span class="ok">200</span><span>31 kB</span></div>
          <div class="row"><span>heic-to.min.js (decoder)</span><span class="ok">200</span><span>1.6 MB</span></div>
          <div class="drop">IMG_4021.HEIC, IMG_4022.HEIC, IMG_4023.HEIC added…</div>
          <div class="empty"><b>0 requests</b>Your photos were converted here.</div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2>Popular conversions</h2>
    <ul class="chips">{pairs.map((p) => <li><a href={`/${p.slug}`}>{p.from} to {p.to}</a></li>)}</ul>
  </section>

  <section class="wrap">
    <div class="pillars">
      <div class="pillar">
        <h3>Private by construction</h3>
        <p>There is no server to upload to. The site is static files; every conversion runs as JavaScript and WebAssembly in your tab. The only requests are for code and an anonymous, cookie-free page count, and the <a href="https://stats.keenankaufman.com/share/878bb036d828/Stayput" rel="noopener">usage stats are public</a>.</p>
      </div>
      <div class="pillar">
        <h3>No limits</h3>
        <p>No file size caps, no "two tasks per hour", no sign-up wall, no watermark. Batch a hundred photos if your device can hold them.</p>
      </div>
      <div class="pillar">
        <h3>Works offline</h3>
        <p>Open a tool once and it is cached for offline use. Install it as an app from your browser menu to keep it a tap away.</p>
      </div>
      <div class="pillar">
        <h3>Open source</h3>
        <p>MIT licensed and <a href="https://github.com/keenanlk/stayput" rel="noopener">on GitHub</a>. Read the code, report a bug, or host your own copy.</p>
      </div>
    </div>
  </section>
</Base>
