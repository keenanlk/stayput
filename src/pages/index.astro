---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import ConversionMap from '../components/ConversionMap.astro';
import { tools, categories } from '../data/tools';
import { conversions, popularConversions, popularTools } from '../data/hubs';
import { guides } from '../data/guides';
import { profiles } from '../data/site';

// Short column headings so the three tool columns line up on one line.
const shortLabel = { images: 'Images', pdf: 'PDFs and files', media: 'Video and audio' };

// Verb-led starting points for the hero. Each slug must be a real tool; the lookup keeps links honest.
const startTiles = [
  { label: 'iPhone photo to JPG', slug: 'heic-to-jpg' },
  { label: 'Shrink an image', slug: 'compress-image' },
  { label: 'Merge PDFs', slug: 'merge-pdf' },
  { label: 'Compress a PDF', slug: 'compress-pdf' },
  { label: 'Remove a background', slug: 'remove-background' },
  { label: 'Video to MP3', slug: 'video-to-mp3' },
].map((t) => {
  const tool = tools.find((x) => x.slug === t.slug);
  if (!tool) throw new Error(`Home page tile points at a missing tool: ${t.slug}`);
  return { label: t.label, href: `/tools/${tool.slug}` };
});

const title = 'Stayput: Free File Tools That Never Upload Your Files';
const description =
  'Convert HEIC to JPG, merge and compress PDFs, shrink images and edit video in your browser. No uploads, no watermarks, no size caps beyond your device. Open source.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Stayput',
    url: Astro.site?.toString(),
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Stayput',
    url: Astro.site?.toString(),
    logo: new URL('/icons/icon-512.png', Astro.site).toString(),
    email: 'hello@stayput.dev',
    sameAs: profiles,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: tools.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t.name,
      url: new URL(`/tools/${t.slug}`, Astro.site).toString(),
    })),
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>Your files stay put.</h1>
        <p class="lede">
          Convert, compress and edit images, PDFs, video and audio right here in your browser. Nothing is uploaded, nothing is watermarked, and the only size limit is your device’s memory. It even works with the Wi-Fi off after your first visit.
        </p>
        <p class="start-label" id="start-h">What do you want to do? Pick one, then drop your file.</p>
        <ul class="start-tiles" aria-labelledby="start-h">
          {startTiles.map((t) => <li><a href={t.href}>{t.label}</a></li>)}
        </ul>
        <p class="start-note">Your file stays in this tab. <a class="hero-link" href="#tools">See all {tools.length} tools</a></p>
      </div>
      <figure>
        <div class="devtools" role="img" aria-label="A browser network panel after converting photos: requests for the site's code and the decoder, then a few small anonymous usage-count requests. None of them carry the photos.">
          <div class="tabs"><span>Elements</span><span>Console</span><span class="on">Network</span><span>Application</span></div>
          <div class="rows">
            <div class="row head"><span>Name</span><span>Status</span><span>Size</span></div>
            <div class="row"><span>heic-to-jpg</span><span class="ok">200</span><span>9.1 kB</span></div>
            <div class="row"><span>heic-to-jpg.a8f3.js</span><span class="ok">200</span><span>31 kB</span></div>
            <div class="row"><span>heic-to.min.js (decoder)</span><span class="ok">200</span><span>1.6 MB</span></div>
            <div class="drop">IMG_4021.HEIC, IMG_4022.HEIC, IMG_4023.HEIC added</div>
            <div class="row"><span>api/st ×4 (usage count)</span><span class="ok">200</span><span>1.9 kB</span></div>
            <div class="empty"><b>No</b> request carried your photos.</div>
          </div>
        </div>
        <figcaption>What your browser's Network tab shows while three iPhone photos convert: the page and its code load, then a few small anonymous usage-count requests. No request carries your photos. Press F12 and try it.</figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap demo" aria-labelledby="demo-h">
    <h2 id="demo-h">Watch it with the network tab open</h2>
    <figure>
      <video controls muted playsinline preload="none" width="1280" height="720" data-poster="/media/stayput-network-tab-poster.webp" aria-label="Demo: three photos convert on Stayput while a network panel lists every request, then, after the page has loaded, the same conversion runs again offline">
        <source src="/media/stayput-network-tab.webm" type="video/webm" />
        <source src="/media/stayput-network-tab.mp4" type="video/mp4" />
        Your browser can't play this video. The text below describes it.
      </video>
      <figcaption>Three HEIC photos convert to JPG while a network panel lists every request the page makes. None of the requests carries a photo. Once the page has loaded, the network is switched off and the same photos convert again. The video has captions and no sound; it runs 23 seconds.</figcaption>
    </figure>
  </section>

  <section class="wrap popular" id="tools" aria-labelledby="popular-h">
    <div class="index-head">
      <h2 id="popular-h">Most used</h2>
      <p>The tools people open first. All {tools.length} are listed below.</p>
    </div>
    <div class="tool-grid">{popularTools.map((t) => <ToolCard tool={t} />)}</div>
  </section>

  <div class="wrap index" aria-label={`All ${tools.length} tools`}>
    {categories.map((c) => {
      const list = tools.filter((t) => t.category === c.id);
      return (
        <section id={`${c.id === 'images' ? 'image' : c.id}-tools`} aria-labelledby={`${c.id}-h`}>
          <div class="index-head">
            <h2 id={`${c.id}-h`}>{shortLabel[c.id]} <span class="count">{list.length}</span></h2>
            <p>{c.blurb}</p>
          </div>
          <div class="tool-grid">{list.map((t) => <ToolCard tool={t} compact />)}</div>
        </section>
      );
    })}
  </div>

  <section class="wrap section split" aria-labelledby="spec-h">
    <div class="spec-intro">
      <h2 id="spec-h">Open the network tab. Your files never appear in it.</h2>
      <p style="margin-top:16px">Every tool here is JavaScript and WebAssembly running in your tab. There is no server that could receive your files, so none does. You will see a few small anonymous usage-count requests; they carry the page, which tool, and rough ranges such as file count and size, never your file. Full list: <a href="/privacy">/privacy</a>.</p>
      <p>Every tool page also counts its own requests after you add files and shows you the list, so you do not have to take our word for it.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/tools/heic-to-jpg">Try it with a photo</a>
        <a class="btn" href="https://github.com/keenanlk/stayput" rel="noopener">Read the source</a>
      </div>
    </div>
    <dl class="spec-sheet">
      <div><dt>Uploads</dt><dd><b>None.</b> The site is static files; every conversion runs in your tab.</dd></div>
      <div><dt>Limits</dt><dd><b>No daily limit.</b> No "two tasks per hour" and no server-side size tier. Batch a hundred photos if your device can hold them.</dd></div>
      <div><dt>Account</dt><dd><b>None.</b> No sign-up wall, no watermark.</dd></div>
      <div><dt>Offline</dt><dd><b>Yes, after your first visit.</b> Open a tool once and it is cached. Install it as an app from your browser menu to keep it a tap away.</dd></div>
      <div><dt>Tracking</dt><dd>An anonymous, cookie-free page count. Never file names or contents.</dd></div>
      <div><dt>Source</dt><dd>MIT licensed and <a href="https://github.com/keenanlk/stayput" rel="noopener">on GitHub</a>. Read the code, report a bug, or host your own copy.</dd></div>
    </dl>
  </section>

  <section class="wrap section split" aria-labelledby="conv-h">
    <div class="conv-intro">
      <h2 id="conv-h">Popular conversions</h2>
      <p class="muted">{conversions.length} conversions, each with its own page. Every one runs in this tab.</p>
      <ConversionMap />
    </div>
    <div>
      <ul class="chips">{popularConversions.map((c) => <li><a href={`/${c.slug}`}>{c.label}</a></li>)}</ul>
      <p class="more-link"><a href="/conversions">See all {conversions.length} conversions</a></p>
    </div>
  </section>

  <section class="wrap section split" aria-labelledby="guides-h">
    <div>
      <h2 id="guides-h">Guides</h2>
      <p class="muted" style="margin-top:12px">Straight answers to the questions behind the tools. <a href="/guides">All guides</a>.</p>
    </div>
    <ul class="guide-list guide-grid">{guides.slice(0, 6).map((g) => <li><a href={`/guides/${g.slug}`}>{g.heading}</a><span class="muted">{g.dek}</span></li>)}</ul>
  </section>
</Base>

<style>
  .start-label { margin: 0 0 12px; font-weight: 650; font-size: 17px; color: var(--on-field); max-width: 44ch; }
  .start-tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; max-width: 560px; }
  .start-tiles li { display: flex; }
  .start-tiles a {
    flex: 1;
    display: flex; align-items: center; justify-content: center; text-align: center;
    min-height: 56px; padding: 10px 12px; border-radius: var(--radius-sm);
    background: var(--on-field); color: #0d2c26; font-weight: 650; font-size: 16px; line-height: 1.2; text-decoration: none;
    border: 1px solid var(--on-field);
  }
  .start-tiles a:hover { background: #ffffff; border-color: #ffffff; }
  .start-note { margin: 14px 0 0; font-size: 15px; color: var(--on-field); }
  @media (max-width: 900px) {
    .start-tiles { max-width: none; }
  }
  @media (max-width: 600px) {
    .hero-grid { padding: 28px 0 44px; gap: 36px; }
    .hero h1 { font-size: clamp(44px, 14vw, 56px); margin-bottom: 14px; }
    .hero .lede { font-size: 16px; margin-bottom: 18px; }
    .start-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>

<script>
  // The poster is a 100 kB image below the fold; fetch it only when the visitor scrolls near it,
  // so it does not compete with the hero for bandwidth.
  const video = document.querySelector<HTMLVideoElement>('.demo video[data-poster]');
  if (video) {
    const load = () => {
      video.poster = video.dataset.poster!;
      video.removeAttribute('data-poster');
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          load();
        }
      }, { rootMargin: '400px' });
      io.observe(video);
    } else {
      load();
    }
  }
</script>
