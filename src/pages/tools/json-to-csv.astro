---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { toolBySlug } from '../../data/tools';
import JsonToCsv from '../../components/options/JsonToCsv.astro';
import JsonToCsvPaste from '../../components/JsonToCsvPaste.astro';
const tool = toolBySlug('json-to-csv')!;
---
<ToolLayout tool={tool}>
  <JsonToCsvPaste slot="panel" />
  <Fragment slot="options"><JsonToCsv /></Fragment>
</ToolLayout>
<script src="../../tools/json-to-csv.ts"></script>
