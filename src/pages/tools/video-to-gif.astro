---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { toolBySlug } from '../../data/tools';
import VideoToGif from '../../components/options/VideoToGif.astro';
import VideoStage from '../../components/VideoStage.astro';
const tool = toolBySlug('video-to-gif')!;
---
<ToolLayout tool={tool}>
  <VideoStage slot="panel" />
  <Fragment slot="options"><VideoToGif /></Fragment>
</ToolLayout>
<script src="../../tools/video-to-gif.ts"></script>
