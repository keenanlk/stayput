---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { toolBySlug } from '../../data/tools';
import ReorderPdf from '../../components/options/ReorderPdf.astro';
import ReorderStage from '../../components/ReorderStage.astro';
const tool = toolBySlug('reorder-pdf')!;
---
<ToolLayout tool={tool}>
  <ReorderStage slot="panel" />
  <Fragment slot="options"><ReorderPdf /></Fragment>
</ToolLayout>
<script src="../../tools/reorder-pdf.ts"></script>
