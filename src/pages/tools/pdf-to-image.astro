---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { toolBySlug } from '../../data/tools';
const tool = toolBySlug('pdf-to-image')!;
---
<ToolLayout tool={tool}>
  <Fragment slot="options">
    <div class="field wide">
      <label>Pages <span class="muted" id="page-info"></span></label>
      <div class="segmented" role="radiogroup" aria-label="Pages">
        <label><input type="radio" name="pages" value="all" checked /><span>All pages</span></label>
        <label><input type="radio" name="pages" value="range" /><span>Choose pages</span></label>
      </div>
    </div>
    <div class="field wide" id="range-field" hidden>
      <label for="range">Pages</label>
      <input type="text" id="range" placeholder="e.g. 1-3, 5" autocomplete="off" />
    </div>
    <div class="field">
      <label for="format">Format</label>
      <select id="format">
        <option value="image/png">PNG</option>
        <option value="image/jpeg">JPG</option>
      </select>
    </div>
    <div class="field">
      <label for="dpi">Resolution</label>
      <select id="dpi">
        <option value="72">72 DPI</option>
        <option value="96">96 DPI</option>
        <option value="150" selected>150 DPI</option>
        <option value="300">300 DPI</option>
      </select>
    </div>
    <div class="field" id="quality-field" hidden>
      <label for="quality">JPG quality <output id="quality-out">90</output></label>
      <input type="range" id="quality" min="40" max="100" value="90" />
    </div>
  </Fragment>
</ToolLayout>
<script src="../../tools/pdf-to-image.ts"></script>
