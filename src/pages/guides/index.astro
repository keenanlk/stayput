---
import Base from '../../layouts/Base.astro';
import HubGroups from '../../components/HubGroups.astro';
import { guides } from '../../data/guides';
import { guideGroups } from '../../data/hubs';

const title = 'Guides: File Privacy, Conversion and PDF How-Tos | Stayput';
const description = 'Plain-language guides to file privacy: whether online converters are safe, how to remove photo location data, and how to check if a site uploads your files.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Stayput guides',
    url: new URL('/guides', Astro.site).toString(),
    description,
    hasPart: guides.map((g) => ({ '@type': 'Article', headline: g.heading, url: new URL(`/guides/${g.slug}`, Astro.site).toString() })),
  },
];
const groups = guideGroups.map((g) => ({ ...g, items: g.items.map((i) => ({ href: `/guides/${i.slug}`, label: i.heading, sub: i.dek })) }));
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="wrap guide page guides-index">
    <h1>Guides</h1>
    <p class="dek">Straight answers to the questions people ask before they reach for a file tool: what is safe, what a file reveals, which format to use, and how to check for yourself.</p>
    <HubGroups groups={groups} />
  </section>
</Base>
