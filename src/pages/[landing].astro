---
/**
 * Landing pages at /<slug>: format pairs (WebP to PNG) run the image converter
 * with the output preset; tool presets (JPG to PDF, Combine PDF) run another
 * tool with its options preset. Both share ToolLayout and the base tool's
 * script, loaded by src/tools/landing.ts.
 */
import ToolLayout from '../layouts/ToolLayout.astro';
import { pairs, pairAsTool } from '../data/pairs';
import { presets, presetAsTool } from '../data/presets';
import ConvertImage from '../components/options/ConvertImage.astro';
import CompressImage from '../components/options/CompressImage.astro';
import StripExif from '../components/options/StripExif.astro';
import MergePdf from '../components/options/MergePdf.astro';
import SplitPdf from '../components/options/SplitPdf.astro';
import ImageToPdf from '../components/options/ImageToPdf.astro';
import PdfToImage from '../components/options/PdfToImage.astro';
import ExtractPdfImages from '../components/options/ExtractPdfImages.astro';
import PdfToWord from '../components/options/PdfToWord.astro';
import CropImage from '../components/options/CropImage.astro';
import ReorderPdf from '../components/options/ReorderPdf.astro';
import VideoToGif from '../components/options/VideoToGif.astro';
import BlurImage from '../components/options/BlurImage.astro';
import RotateImage from '../components/options/RotateImage.astro';
import VideoToMp3 from '../components/options/VideoToMp3.astro';
import GifToMp4 from '../components/options/GifToMp4.astro';
import CompressVideo from '../components/options/CompressVideo.astro';
import VideoToMp4 from '../components/options/VideoToMp4.astro';
import CompressPng from '../components/options/CompressPng.astro';
import CompressGif from '../components/options/CompressGif.astro';
import TrimVideo from '../components/options/TrimVideo.astro';
import MuteVideo from '../components/options/MuteVideo.astro';
import ResizeVideo from '../components/options/ResizeVideo.astro';
import RotateVideo from '../components/options/RotateVideo.astro';
import CropVideo from '../components/options/CropVideo.astro';
import VideoSpeed from '../components/options/VideoSpeed.astro';
import MergeVideos from '../components/options/MergeVideos.astro';
import AddAudioToVideo from '../components/options/AddAudioToVideo.astro';
import ReverseVideo from '../components/options/ReverseVideo.astro';
import VideoToJpg from '../components/options/VideoToJpg.astro';
import TrimAudio from '../components/options/TrimAudio.astro';
import AudioToVideo from '../components/options/AudioToVideo.astro';
import QrStage from '../components/QrStage.astro';
import RecordStage from '../components/RecordStage.astro';
import MergeAudio from '../components/options/MergeAudio.astro';
import CollageMaker from '../components/options/CollageMaker.astro';
import CollageStage from '../components/CollageStage.astro';
import SplitImage from '../components/options/SplitImage.astro';
import GridStage from '../components/GridStage.astro';
import AddText from '../components/options/AddText.astro';
import TextStage from '../components/TextStage.astro';
import CompressAudio from '../components/options/CompressAudio.astro';
import VolumeBooster from '../components/options/VolumeBooster.astro';
import RemoveNoise from '../components/options/RemoveNoise.astro';
import PitchChanger from '../components/options/PitchChanger.astro';
import AudioConverter from '../components/options/AudioConverter.astro';
import AudioStage from '../components/AudioStage.astro';
import ImageToText from '../components/options/ImageToText.astro';
import ColorPicker from '../components/options/ColorPicker.astro';
import RemoveBackground from '../components/options/RemoveBackground.astro';
import PassportPhoto from '../components/options/PassportPhoto.astro';
import Watermark from '../components/options/Watermark.astro';
import WatermarkPdf from '../components/options/WatermarkPdf.astro';
import StickerMaker from '../components/options/StickerMaker.astro';
import ProfilePicture from '../components/options/ProfilePicture.astro';
import BlackAndWhite from '../components/options/BlackAndWhite.astro';
import UpscaleImage from '../components/options/UpscaleImage.astro';
import ImageToSvg from '../components/options/ImageToSvg.astro';
import GifMaker from '../components/options/GifMaker.astro';
import ResizePdf from '../components/options/ResizePdf.astro';
import WatermarkStage from '../components/WatermarkStage.astro';
import ColorStage from '../components/ColorStage.astro';
import CropStage from '../components/CropStage.astro';
import ReorderStage from '../components/ReorderStage.astro';
import SignStage from '../components/SignStage.astro';
import VideoStage from '../components/VideoStage.astro';
import BlurStage from '../components/BlurStage.astro';
import RotateStage from '../components/RotateStage.astro';
import MonoStage from '../components/MonoStage.astro';
import SvgStage from '../components/SvgStage.astro';
import GifStage from '../components/GifStage.astro';
import TunerStage from '../components/TunerStage.astro';
import MetronomeStage from '../components/MetronomeStage.astro';

export function getStaticPaths() {
  return [
    ...pairs.map((p) => ({ params: { landing: p.slug }, props: { tool: pairAsTool(p), base: 'convert-image', engine: p.outputType === 'image/x-icon' ? 'to-ico' : 'convert-image', intro: p.intro, defaults: { format: p.outputType } } })),
    ...presets.map((p) => ({ params: { landing: p.slug }, props: { tool: presetAsTool(p), base: p.base, intro: p.intro, defaults: p.defaults ?? {} } })),
  ];
}
const { tool, base, intro, defaults } = Astro.props;
const engine: string = 'engine' in Astro.props ? (Astro.props.engine as string) : base;
const options = {
  'convert-image': ConvertImage,
  'compress-image': CompressImage,
  'strip-exif': StripExif,
  'merge-pdf': MergePdf,
  'split-pdf': SplitPdf,
  'image-to-pdf': ImageToPdf,
  'pdf-to-image': PdfToImage,
  'extract-pdf-images': ExtractPdfImages,
  'pdf-to-word': PdfToWord,
  'crop-image': CropImage,
  'reorder-pdf': ReorderPdf,
  'video-to-gif': VideoToGif,
  'blur-image': BlurImage,
  'rotate-image': RotateImage,
  'video-to-mp3': VideoToMp3,
  'gif-to-mp4': GifToMp4,
  'compress-video': CompressVideo,
  'video-to-mp4': VideoToMp4,
  'compress-png': CompressPng,
  'compress-gif': CompressGif,
  'trim-video': TrimVideo,
  'mute-video': MuteVideo,
  'resize-video': ResizeVideo,
  'rotate-video': RotateVideo,
  'crop-video': CropVideo,
  'video-speed': VideoSpeed,
  'merge-videos': MergeVideos,
  'add-audio-to-video': AddAudioToVideo,
  'reverse-video': ReverseVideo,
  'video-to-jpg': VideoToJpg,
  'trim-audio': TrimAudio,
  'audio-to-video': AudioToVideo,
  'merge-audio': MergeAudio,
  'collage-maker': CollageMaker,
  'split-image': SplitImage,
  'add-text-to-image': AddText,
  'compress-audio': CompressAudio,
  'volume-booster': VolumeBooster,
  'remove-noise': RemoveNoise,
  'pitch-changer': PitchChanger,
  'audio-converter': AudioConverter,
  'image-to-text': ImageToText,
  'color-picker': ColorPicker,
  'remove-background': RemoveBackground,
  'passport-photo': PassportPhoto,
  'watermark-image': Watermark,
  'watermark-pdf': WatermarkPdf,
  // Remove PDF metadata has no options: the report is the interface.
  'remove-pdf-metadata': null,
  // Grayscale PDF has no options either.
  'grayscale-pdf': null,
  'sticker-maker': StickerMaker,
  'profile-picture-maker': ProfilePicture,
  'black-and-white-image': BlackAndWhite,
  'upscale-image': UpscaleImage,
  'image-to-svg': ImageToSvg,
  'gif-maker': GifMaker,
  'resize-pdf': ResizePdf,
  // Sign PDF, the QR code generator and the screen recorder have no option controls outside their stages.
  'sign-pdf': null,
  'qr-code-generator': null,
  'screen-recorder': null,
  // The tuner keeps its instrument and A4 controls in its stage.
  'tuner': null,
  'metronome': null,
} as const;
if (!(base in options)) throw new Error(`Landing page ${tool.slug} has no options component for ${base}`);
const Options = options[base as keyof typeof options];
---
<ToolLayout tool={tool} intro={intro} engineSlug={engine} base={base}>
  {(base === 'strip-exif' || base === 'remove-pdf-metadata') && <div slot="panel" id="meta-report" class="meta-report" hidden></div>}
  {(base === 'crop-image' || base === 'crop-video') && <CropStage slot="panel" />}
  {base === 'reorder-pdf' && <ReorderStage slot="panel" />}
  {base === 'sign-pdf' && <SignStage slot="panel" />}
  {(base === 'video-to-gif' || base === 'trim-video') && <VideoStage slot="panel" />}
  {base === 'trim-audio' && <AudioStage slot="panel" />}
  {base === 'qr-code-generator' && <QrStage slot="panel" defaults={defaults} />}
  {base === 'screen-recorder' && <RecordStage slot="panel" defaults={defaults} />}
  {base === 'blur-image' && <BlurStage slot="panel" />}
  {base === 'rotate-image' && <RotateStage slot="panel" />}
  {base === 'black-and-white-image' && <MonoStage slot="panel" />}
  {base === 'image-to-svg' && <SvgStage slot="panel" />}
  {base === 'gif-maker' && <GifStage slot="panel" />}
  {base === 'tuner' && <TunerStage slot="panel" defaults={defaults} />}
  {base === 'metronome' && <MetronomeStage slot="panel" defaults={defaults} />}
  {(base === 'watermark-image' || base === 'watermark-pdf') && <WatermarkStage slot="panel" />}
  {base === 'collage-maker' && <CollageStage slot="panel" />}
  {base === 'split-image' && <GridStage slot="panel" />}
  {base === 'add-text-to-image' && <TextStage slot="panel" />}
  {base === 'color-picker' && <ColorStage slot="panel" />}
  {base === 'pdf-to-word' && <pre slot="panel" id="text-preview" class="text-preview" hidden aria-label="Extracted text preview"></pre>}
  <Fragment slot="options">{Options && <Options defaults={defaults} />}</Fragment>
</ToolLayout>
{base === 'pdf-to-word' && (
  <style is:global>
    .text-preview { max-height: 260px; overflow: auto; white-space: pre-wrap; font: 14px/1.5 var(--font-body, inherit); padding: 12px 14px; border-radius: var(--radius-sm); background: var(--surface-2); color: var(--ink-2); margin: 0; }
  </style>
)}
{(base === 'strip-exif' || base === 'remove-pdf-metadata') && (
  <style is:global>
    .meta-list { margin: 6px 0 0; padding-left: 18px; }
    .meta-report { display: grid; gap: 8px; font-size: 14px; }
    .meta-row { padding: 10px 12px; border-radius: var(--radius-sm); background: var(--surface-2); color: var(--ink-2); }
    .meta-row strong { color: var(--ink); }
    .meta-row.has-gps { border-left: 4px solid var(--warn); }
  </style>
)}
<script src="../tools/landing.ts"></script>
