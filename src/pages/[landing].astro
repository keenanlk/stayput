---
/**
 * Landing pages at /<slug>: format pairs (WebP to PNG) run the image converter
 * with the output preset; tool presets (JPG to PDF, Combine PDF) run another
 * tool with its options preset. Both share ToolLayout and the base tool's
 * script, loaded by src/tools/landing.ts.
 */
import ToolLayout from '../layouts/ToolLayout.astro';
import { pairs, pairAsTool } from '../data/pairs';
import { presets, presetAsTool } from '../data/presets';
import ConvertImage from '../components/options/ConvertImage.astro';
import CompressImage from '../components/options/CompressImage.astro';
import StripExif from '../components/options/StripExif.astro';
import MergePdf from '../components/options/MergePdf.astro';
import SplitPdf from '../components/options/SplitPdf.astro';
import ImageToPdf from '../components/options/ImageToPdf.astro';
import PdfToImage from '../components/options/PdfToImage.astro';
import PdfToWord from '../components/options/PdfToWord.astro';
import CropImage from '../components/options/CropImage.astro';
import ReorderPdf from '../components/options/ReorderPdf.astro';
import VideoToGif from '../components/options/VideoToGif.astro';
import BlurImage from '../components/options/BlurImage.astro';
import RotateImage from '../components/options/RotateImage.astro';
import VideoToMp3 from '../components/options/VideoToMp3.astro';
import GifToMp4 from '../components/options/GifToMp4.astro';
import CompressVideo from '../components/options/CompressVideo.astro';
import VideoToMp4 from '../components/options/VideoToMp4.astro';
import ImageToText from '../components/options/ImageToText.astro';
import ColorPicker from '../components/options/ColorPicker.astro';
import ColorStage from '../components/ColorStage.astro';
import CropStage from '../components/CropStage.astro';
import ReorderStage from '../components/ReorderStage.astro';
import SignStage from '../components/SignStage.astro';
import VideoStage from '../components/VideoStage.astro';
import BlurStage from '../components/BlurStage.astro';
import RotateStage from '../components/RotateStage.astro';

export function getStaticPaths() {
  return [
    ...pairs.map((p) => ({ params: { landing: p.slug }, props: { tool: pairAsTool(p), base: 'convert-image', engine: p.outputType === 'image/x-icon' ? 'to-ico' : 'convert-image', intro: p.intro, defaults: { format: p.outputType } } })),
    ...presets.map((p) => ({ params: { landing: p.slug }, props: { tool: presetAsTool(p), base: p.base, intro: p.intro, defaults: p.defaults ?? {} } })),
  ];
}
const { tool, base, intro, defaults } = Astro.props;
const engine: string = 'engine' in Astro.props ? (Astro.props.engine as string) : base;
const options = {
  'convert-image': ConvertImage,
  'compress-image': CompressImage,
  'strip-exif': StripExif,
  'merge-pdf': MergePdf,
  'split-pdf': SplitPdf,
  'image-to-pdf': ImageToPdf,
  'pdf-to-image': PdfToImage,
  'pdf-to-word': PdfToWord,
  'crop-image': CropImage,
  'reorder-pdf': ReorderPdf,
  'video-to-gif': VideoToGif,
  'blur-image': BlurImage,
  'rotate-image': RotateImage,
  'video-to-mp3': VideoToMp3,
  'gif-to-mp4': GifToMp4,
  'compress-video': CompressVideo,
  'video-to-mp4': VideoToMp4,
  'image-to-text': ImageToText,
  'color-picker': ColorPicker,
  // Sign PDF has no option controls; everything happens on the stage.
  'sign-pdf': null,
} as const;
if (!(base in options)) throw new Error(`Landing page ${tool.slug} has no options component for ${base}`);
const Options = options[base as keyof typeof options];
---
<ToolLayout tool={tool} intro={intro} engineSlug={engine} base={base}>
  {base === 'strip-exif' && <div slot="panel" id="meta-report" class="meta-report" hidden></div>}
  {base === 'crop-image' && <CropStage slot="panel" />}
  {base === 'reorder-pdf' && <ReorderStage slot="panel" />}
  {base === 'sign-pdf' && <SignStage slot="panel" />}
  {base === 'video-to-gif' && <VideoStage slot="panel" />}
  {base === 'blur-image' && <BlurStage slot="panel" />}
  {base === 'rotate-image' && <RotateStage slot="panel" />}
  {base === 'color-picker' && <ColorStage slot="panel" />}
  {base === 'pdf-to-word' && <pre slot="panel" id="text-preview" class="text-preview" hidden aria-label="Extracted text preview"></pre>}
  <Fragment slot="options">{Options && <Options defaults={defaults} />}</Fragment>
</ToolLayout>
{base === 'pdf-to-word' && (
  <style is:global>
    .text-preview { max-height: 260px; overflow: auto; white-space: pre-wrap; font: 14px/1.5 var(--font-body, inherit); padding: 12px 14px; border-radius: var(--radius-sm); background: var(--surface-2); color: var(--ink-2); margin: 0; }
  </style>
)}
{base === 'strip-exif' && (
  <style is:global>
    .meta-report { display: grid; gap: 8px; font-size: 14px; }
    .meta-row { padding: 10px 12px; border-radius: var(--radius-sm); background: var(--surface-2); color: var(--ink-2); }
    .meta-row strong { color: var(--ink); }
    .meta-row.has-gps { border-left: 4px solid var(--warn); }
  </style>
)}
<script src="../tools/landing.ts"></script>
