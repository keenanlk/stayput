---
/**
 * The tuner: the note being played, a needle for how many cents sharp or flat
 * it is, and for instruments the open strings, each of which plays its
 * reference note. It replaces the drop zone. Driven by src/tools/tuner.ts.
 */
import Icon from './Icon.astro';
import { instruments } from '../lib/tuner';
interface Props { defaults?: Record<string, string> }
const { defaults = {} } = Astro.props;
const chosen = instruments.some((i) => i.id === defaults.instrument) ? defaults.instrument : 'chromatic';
---
<div id="tuner-panel" class="tuner-panel" data-state="idle">
  <div class="tuner-deck">
    <div class="tuner-idle" id="tuner-idle">
      <Icon name="tuner" />
      <strong>Tune by ear, with your microphone</strong>
      <span>Your browser asks for the microphone. The sound is measured in this tab; nothing is recorded or sent anywhere.</span>
    </div>
    <div class="tuner-live" id="tuner-live" hidden>
      <p class="tuner-note" id="tuner-note" aria-live="polite"><span id="tuner-name">–</span><sub id="tuner-octave"></sub></p>
      <div class="tuner-scale" aria-hidden="true">
        <div class="tuner-zone"></div>
        <span class="tuner-tick" style="left:0%">−50</span>
        <span class="tuner-tick" style="left:25%">−25</span>
        <span class="tuner-tick" style="left:50%">0</span>
        <span class="tuner-tick" style="left:75%">+25</span>
        <span class="tuner-tick" style="left:100%">+50</span>
        <div class="tuner-needle" id="tuner-needle"></div>
      </div>
      <p class="tuner-hint" id="tuner-hint">Play one string or note</p>
      <p class="muted small tuner-freq" id="tuner-freq">– Hz</p>
    </div>
  </div>
  <div class="tuner-strings" id="tuner-strings" aria-label="Open strings: press one to hear its note"></div>
  <div class="tuner-controls">
    <button type="button" class="btn btn-primary btn-lg" id="tuner-start">Start the tuner</button>
    <button type="button" class="btn btn-lg btn-ghost" id="tuner-stop" hidden>Stop using the microphone</button>
  </div>
  <div class="tuner-options">
    <div class="field">
      <label for="instrument">Instrument</label>
      <select id="instrument">
        {instruments.map((i) => <option value={i.id} selected={i.id === chosen}>{i.label}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="a4">Reference pitch, A4 in Hz</label>
      <input id="a4" type="number" min="415" max="466" step="1" value={defaults.a4 ?? '440'} inputmode="numeric" />
    </div>
  </div>
  <p class="muted small tuner-message" id="tuner-message" aria-live="polite"></p>
</div>
<style is:global>
  .tool-panel:has(#tuner-panel) #drop,
  .tool-panel:has(#tuner-panel) #file-list,
  .tool-panel:has(#tuner-panel) .run-dock { display: none; }
  .tuner-panel { display: grid; gap: 16px; }
  .tuner-deck { min-height: 230px; background: var(--surface-2); border: 1px dashed var(--line-strong); border-radius: var(--radius); display: grid; place-items: center; padding: 20px; }
  .tuner-panel:not([data-state='idle']) .tuner-deck { border-style: solid; }
  .tuner-idle { display: grid; justify-items: center; gap: 6px; text-align: center; color: var(--muted); }
  .tuner-idle strong { color: var(--ink); font-size: 1.05rem; }
  .tuner-idle svg { width: 36px; height: 36px; color: var(--accent); }
  .tuner-live { width: 100%; max-width: 560px; display: grid; gap: 10px; justify-items: center; }
  .tuner-note { margin: 0; font-size: clamp(4rem, 14vw, 6.5rem); line-height: 1; font-weight: 800; color: var(--ink); font-variant-numeric: tabular-nums; }
  .tuner-note sub { font-size: 0.32em; font-weight: 700; color: var(--muted); vertical-align: baseline; margin-left: 4px; }
  .tuner-panel[data-signal='none'] .tuner-note { color: var(--muted); }
  .tuner-panel[data-tuned='true'] .tuner-note { color: var(--accent); }
  .tuner-scale { position: relative; width: 100%; height: 44px; border-bottom: 2px solid var(--line-strong); }
  .tuner-zone { position: absolute; left: 45%; width: 10%; top: 0; bottom: 0; background: var(--accent-soft); border-radius: 4px 4px 0 0; }
  .tuner-tick { position: absolute; bottom: -22px; transform: translateX(-50%); font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .tuner-tick::before { content: ''; position: absolute; left: 50%; bottom: 22px; width: 1px; height: 10px; background: var(--line-strong); }
  .tuner-needle { position: absolute; left: 50%; top: 0; bottom: 0; width: 3px; margin-left: -1.5px; border-radius: 2px; background: var(--ink); transition: left 120ms ease-out; }
  .tuner-panel[data-tuned='true'] .tuner-needle { background: var(--accent); }
  .tuner-panel[data-signal='none'] .tuner-needle { opacity: 0.3; }
  .tuner-hint { margin: 26px 0 0; font-size: 1.15rem; font-weight: 700; color: var(--ink); text-align: center; }
  .tuner-panel[data-tuned='true'] .tuner-hint { color: var(--accent); }
  .tuner-freq { margin: 0; font-variant-numeric: tabular-nums; }
  @media (prefers-reduced-motion: reduce) { .tuner-needle { transition: none; } }
  .tuner-strings { display: flex; flex-wrap: wrap; gap: 8px; }
  .tuner-strings:empty { display: none; }
  .tuner-string { flex: 1 1 0; min-width: 44px; max-width: 96px; padding: 10px 6px; border-radius: var(--radius-sm); border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink); font: inherit; font-weight: 700; cursor: pointer; font-variant-numeric: tabular-nums; }
  .tuner-string:hover { border-color: var(--accent); }
  .tuner-string:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .tuner-string[data-active='true'] { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .tuner-string[data-tuned='true'] { background: var(--accent); border-color: var(--accent); color: var(--accent-contrast); }
  .tuner-controls { display: flex; flex-wrap: wrap; gap: 10px; }
  .tuner-options { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px 28px; align-items: start; }
  .tuner-message { margin: 0; }
  .tuner-message.is-warn { color: var(--warn); font-weight: 600; }
</style>
