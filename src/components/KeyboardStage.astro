---
/**
 * The keyboard tester: an on-screen keyboard that lights each key as it is
 * pressed, and a log of each key event. It replaces the drop zone. The keys are
 * drawn by src/tools/keyboard-tester.ts from src/lib/keyboard-tester.ts.
 */
---
<div id="kbd-panel" class="kbd-panel">
  <div class="kbd-bar">
    <fieldset class="kbd-layouts">
      <legend>Layout</legend>
      <label class="kbd-choice"><input type="radio" name="kbd-layout" value="ansi" checked /><span>ANSI (US)</span></label>
      <label class="kbd-choice"><input type="radio" name="kbd-layout" value="iso" /><span>ISO (UK, European)</span></label>
    </fieldset>
    <p class="kbd-count" id="kbd-count" aria-live="polite">0 keys tested</p>
    <button type="button" class="btn btn-lg" id="kbd-reset">Reset</button>
  </div>
  <p class="muted small" id="kbd-hint">Press any key. Each key lights up when you press it and stays marked as tested.</p>
  <div class="kbd-board" id="kbd-board" aria-label="On-screen keyboard"></div>
  <div class="kbd-last" aria-live="off">
    <span>Last key</span><strong id="kbd-last-key">none yet</strong>
    <span>Code</span><strong id="kbd-last-code">none yet</strong>
  </div>
  <div class="kbd-logwrap">
    <h2 class="kbd-loghead">Key log</h2>
    <ol class="kbd-log" id="kbd-log" aria-label="Key events, newest first"></ol>
  </div>
  <p class="muted small">Some keys never reach a web page: Fn, most media and brightness keys, and shortcuts the system keeps for itself such as Cmd+Tab, Alt+Tab or the Windows key. If a key does not light up here, the browser was never told about it, so this page cannot say whether the key works.</p>
</div>
<style is:global>
  .tool-panel:has(#kbd-panel) #drop,
  .tool-panel:has(#kbd-panel) #file-list,
  .tool-panel:has(#kbd-panel) .run-dock { display: none; }
  .kbd-panel { display: grid; gap: 14px; }
  .kbd-bar { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: end; }
  .kbd-layouts { margin: 0; padding: 0; border: 0; min-width: 0; display: flex; flex-wrap: wrap; gap: 10px; flex: 1 1 320px; }
  .kbd-layouts legend { padding: 0; margin-bottom: 8px; font-weight: 600; font-size: 14px; }
  .kbd-choice { flex: 1 1 130px; position: relative; }
  .kbd-choice input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .kbd-choice span { display: block; text-align: center; padding: 10px; border: 1px solid var(--line-strong); border-radius: var(--radius); background: var(--surface); color: var(--ink); font-weight: 600; }
  .kbd-choice input:checked + span { background: var(--accent); border-color: var(--accent); color: #fff; }
  .kbd-choice input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .kbd-count { margin: 0; font-weight: 700; font-variant-numeric: tabular-nums; }
  .kbd-board { display: flex; flex-wrap: wrap; gap: 18px; align-items: flex-start; overflow-x: auto; padding: 10px; background: var(--surface-2); border: 1px solid var(--line-strong); border-radius: var(--radius); --u: 38px; }
  .kbd-block { display: grid; gap: 4px; }
  .kbd-row { display: flex; gap: 4px; min-height: var(--u); }
  .kbd-key { box-sizing: border-box; width: calc(var(--w) * var(--u) + (var(--w) - 1) * 4px); height: var(--u); display: grid; place-content: center; font-size: 12px; font-weight: 600; border: 1px solid var(--line-strong); border-radius: 6px; background: var(--surface); color: var(--ink); user-select: none; }
  .kbd-gap { width: calc(var(--w) * var(--u) + (var(--w) - 1) * 4px); }
  .kbd-key.is-tested { background: color-mix(in srgb, var(--accent) 28%, var(--surface)); border-color: var(--accent); }
  .kbd-key.is-down { background: var(--accent); color: #fff; border-color: var(--accent); }
  .kbd-last { display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; font-size: 15px; }
  .kbd-last span { color: var(--muted, inherit); }
  .kbd-last strong { font-family: ui-monospace, monospace; overflow-wrap: anywhere; }
  .kbd-loghead { margin: 0 0 6px; font-size: 1rem; }
  .kbd-log { margin: 0; padding: 0; list-style: none; max-height: 220px; overflow: auto; border: 1px solid var(--line-strong); border-radius: var(--radius); font-family: ui-monospace, monospace; font-size: 13px; }
  .kbd-log li { padding: 5px 10px; border-bottom: 1px solid var(--line); overflow-wrap: anywhere; }
  .kbd-log li:last-child { border-bottom: 0; }
  .kbd-log:empty::before { content: 'No keys pressed yet.'; display: block; padding: 10px; color: var(--muted, inherit); }
</style>
