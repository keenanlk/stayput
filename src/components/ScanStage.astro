---
/**
 * The QR code scanner's own panel: a camera card beneath the shell's drop zone,
 * and the place the result cards are drawn. Images dropped, pasted or chosen go
 * through the shell; the camera starts only when its button is pressed. Driven
 * by src/tools/qr-code-scanner.ts. The copy shown while the camera starts or
 * fails lives in src/lib/qr-scan.ts.
 */
import Icon from './Icon.astro';
import { CAMERA_COPY } from '../lib/qr-scan';
interface Props { defaults?: Record<string, string> }
const { defaults = {} } = Astro.props;
const focus = defaults.focus ?? 'any';
---
<div id="qs-panel" class="qs-panel" data-focus={focus}>
  <section id="qs-camera" class="qs-camera" data-state="idle" aria-labelledby="qs-heading">
    <div class="qs-screen">
      <video id="qs-video" class="qs-video" playsinline muted hidden></video>
      <div class="qs-idle" id="qs-idle">
        <Icon name="video" />
        <strong id="qs-heading">{CAMERA_COPY.idleHeading}</strong>
        <span>{CAMERA_COPY.idle}</span>
      </div>
    </div>
    <div class="qs-controls">
      <button type="button" class="btn btn-lg" id="qs-start">Scan with camera</button>
      <button type="button" class="btn btn-lg btn-ghost" id="qs-stop" hidden>Stop</button>
      <button type="button" class="btn btn-lg btn-ghost" id="qs-switch" hidden>Switch camera</button>
      <button type="button" class="btn btn-lg btn-ghost" id="qs-torch" hidden aria-pressed="false">Light</button>
    </div>
    <p class="muted small qs-note" id="qs-note" role="status" aria-live="polite"></p>
  </section>
  <div id="qs-results" class="qs-results" aria-live="polite"></div>
</div>
<style is:global>
  /* The cards below replace the shell's own results block (the text is still produced for Copy and Download). */
  .tool-panel:has(#qs-panel) #results { display: none; }
  .qs-panel { display: grid; gap: 16px; margin-top: 16px; }
  .qs-camera { display: grid; gap: 12px; }
  .qs-screen { position: relative; min-height: 120px; background: var(--surface-2); border: 1px dashed var(--line-strong); border-radius: var(--radius); display: grid; place-items: center; overflow: hidden; }
  .qs-camera[data-state='live'] .qs-screen { aspect-ratio: 16 / 9; max-height: 62vh; background: #000; border-style: solid; }
  .qs-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .qs-camera[data-mirror='true'] .qs-video { transform: scaleX(-1); }
  .qs-idle { display: grid; justify-items: center; gap: 6px; padding: 18px; text-align: center; color: var(--muted); }
  .qs-idle strong { color: var(--ink); font-size: 1.05rem; }
  .qs-idle svg { width: 32px; height: 32px; color: var(--accent); }
  .qs-controls { display: flex; flex-wrap: wrap; gap: 10px; }
  .qs-note { margin: 0; white-space: pre-line; }
  .qs-note.is-warn { color: var(--warn); font-weight: 600; }
  .qs-results { display: grid; gap: 14px; }
  .qs-results:empty { display: none; }
  .qs-summary { margin: 0; font-weight: 600; }
  .qs-file { margin: 4px 0 0; font-size: 0.95rem; color: var(--ink-2); overflow-wrap: anywhere; }
  .qs-card { display: grid; gap: 10px; padding: 14px 16px; border-radius: var(--radius); background: var(--surface-2); border: 1px solid var(--line); min-width: 0; }
  .qs-card h3 { margin: 0; font-size: 0.95rem; color: var(--muted); font-weight: 600; }
  .qs-kind { display: inline-block; width: fit-content; padding: 2px 10px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line-strong); font-size: 0.85rem; font-weight: 700; color: var(--ink); }
  .qs-domain { margin: 0; font-size: 1.5rem; line-height: 1.25; overflow-wrap: anywhere; color: var(--ink-2); }
  .qs-domain strong { color: var(--ink); }
  .qs-address { margin: 0; padding: 10px 12px; border-radius: var(--radius-sm); background: var(--surface); border: 1px solid var(--line); font: 0.9rem/1.45 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word; }
  .qs-warnings { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .qs-warnings li { padding: 8px 10px; border-left: 4px solid var(--warn); background: var(--surface); border-radius: var(--radius-sm); font-size: 0.95rem; overflow-wrap: anywhere; }
  .qs-fields { margin: 0; display: grid; gap: 6px; }
  .qs-fields div { display: flex; gap: 10px; justify-content: space-between; align-items: baseline; flex-wrap: wrap; border-bottom: 1px solid var(--line); padding-bottom: 6px; }
  .qs-fields dt { color: var(--muted); }
  .qs-fields dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; min-width: 0; white-space: pre-wrap; }
  .qs-text { margin: 0; padding: 10px 12px; border-radius: var(--radius-sm); background: var(--surface); border: 1px solid var(--line); white-space: pre-wrap; overflow-wrap: anywhere; font: inherit; }
  .qs-card p { margin: 0; overflow-wrap: anywhere; }
  .qs-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .qs-fail { margin: 0; padding: 10px 12px; border-left: 4px solid var(--warn); background: var(--surface-2); border-radius: var(--radius-sm); }
  .qs-fail ul { margin: 6px 0 0; padding-left: 18px; }
</style>
