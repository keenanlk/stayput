---
import { tools } from '../data/tools';
import { pairs } from '../data/pairs';
import { presets } from '../data/presets';
import { guides } from '../data/guides';
const images = tools.filter((t) => t.category === 'images');
const pdfs = tools.filter((t) => t.category === 'pdf');
const media = tools.filter((t) => t.category === 'media');
---
<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div>
        <h3>Stayput</h3>
        <p>Free file tools that run entirely in your browser. Nothing you drop here is uploaded anywhere. Open source under the MIT license.</p>
        <ul class="links">
          <li><a href="https://github.com/keenanlk/stayput" rel="noopener">Source code on GitHub</a></li>
        </ul>
      </div>
      <div>
        <h3>Image tools</h3>
        <ul>{images.map((t) => <li><a href={`/tools/${t.slug}`}>{t.name}</a></li>)}</ul>
        <h3>Video and audio</h3>
        <ul>{media.map((t) => <li><a href={`/tools/${t.slug}`}>{t.name}</a></li>)}</ul>
      </div>
      <div>
        <h3>PDF tools</h3>
        <ul>{pdfs.map((t) => <li><a href={`/tools/${t.slug}`}>{t.name}</a></li>)}</ul>
      </div>
      <div>
        <h3><a href="/guides">Guides</a></h3>
        <ul>
          {guides.slice(0, 5).map((g) => <li><a href={`/guides/${g.slug}`}>{g.heading}</a></li>)}
          <li><a href="/guides">All guides →</a></li>
        </ul>
      </div>
    </div>
    <div class="conversions">
      <a href="/conversions">All {pairs.length + presets.length} conversions →</a>
    </div>
    <div class="legal">
      <span>© {new Date().getFullYear()} Stayput</span>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/about">About</a>
      <a href="/press">Press</a>
      <a href="/mcp">For AI assistants</a>
      <a href="https://github.com/keenanlk/stayput/issues" rel="noopener">Report a bug</a>
      <a href="mailto:hello@stayput.dev">hello@stayput.dev</a>
      <span>No cookies, no uploads, no accounts.</span>
    </div>
  </div>
</footer>
