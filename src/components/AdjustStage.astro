---
/** Live preview for the adjust tool: the first image with the current settings; press and hold to see the original. Driven by src/tools/adjust-image.ts. */
---
<div id="adjust-panel" class="rotate-panel" hidden>
  <div class="rotate-stage adjust-stage"><canvas id="adjust-canvas" aria-label="Preview of the adjusted image"></canvas></div>
  <div class="adjust-bar">
    <p class="muted small rotate-hint" id="adjust-hint"></p>
    <span class="adjust-actions">
      <button class="btn btn-sm btn-ghost" type="button" id="adjust-compare">Hold to compare</button>
      <button class="btn btn-sm btn-ghost" type="button" id="adjust-reset">Reset</button>
    </span>
  </div>
</div>
<style is:global>
  .rotate-panel { display: grid; gap: 8px; }
  .rotate-stage { line-height: 0; justify-self: start; max-width: 100%; background: repeating-conic-gradient(var(--surface-2) 0 25%, var(--surface) 0 50%) 0 0 / 16px 16px; border: 1px solid var(--line); box-shadow: var(--shadow); }
  .rotate-stage canvas { display: block; max-width: 100%; max-height: 55vh; width: auto; height: auto; }
  .rotate-hint { margin: 0; }
  .adjust-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .adjust-bar .rotate-hint { flex: 1 1 220px; }
  .adjust-actions { display: flex; gap: 4px; margin-left: auto; }
  #adjust-compare { touch-action: none; user-select: none; -webkit-user-select: none; }
</style>
