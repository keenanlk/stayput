---
/** The collage stage: a live preview of the whole collage. Driven by src/tools/collage-maker.ts. */
---
<div id="collage-panel" class="collage-panel" hidden>
  <div class="collage-stage"><canvas id="collage-canvas" aria-label="Preview of the collage"></canvas></div>
  <p class="muted small collage-hint" id="collage-hint"></p>
</div>
<style is:global>
  .collage-panel { display: grid; gap: 8px; }
  .collage-stage { line-height: 0; justify-self: start; max-width: 100%; border: 1px solid var(--line); box-shadow: var(--shadow); background: repeating-conic-gradient(var(--surface-2) 0 25%, var(--surface) 0 50%) 0 0 / 16px 16px; }
  .collage-stage canvas { display: block; max-width: 100%; max-height: 60vh; width: auto; height: auto; }
  .collage-hint { margin: 0; }
</style>
