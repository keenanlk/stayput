---
/** Live preview for the black and white tool: the first image with the chosen look. Driven by src/tools/black-and-white-image.ts. */
---
<div id="mono-panel" class="rotate-panel" hidden>
  <div class="rotate-stage"><canvas id="mono-canvas" aria-label="Preview of the black and white image"></canvas></div>
  <p class="muted small rotate-hint" id="mono-hint"></p>
</div>
<style is:global>
  .rotate-panel { display: grid; gap: 8px; }
  .rotate-stage { line-height: 0; justify-self: start; max-width: 100%; background: repeating-conic-gradient(var(--surface-2) 0 25%, var(--surface) 0 50%) 0 0 / 16px 16px; border: 1px solid var(--line); box-shadow: var(--shadow); }
  .rotate-stage canvas { display: block; max-width: 100%; max-height: 55vh; width: auto; height: auto; }
  .rotate-hint { margin: 0; }
</style>
