---
/**
 * The signature maker: Draw, Type or Photo, one result frame, and the buttons
 * that save or carry it. It replaces the drop zone, since nothing is dropped
 * on the shell. Driven by src/tools/signature-maker.ts; the maths is in
 * src/lib/signature.ts.
 */
interface Props { defaults?: Record<string, string> }
const { defaults = {} } = Astro.props;
const modes = [['draw', 'Draw'], ['type', 'Type'], ['photo', 'Photo']] as const;
const mode = modes.some(([m]) => m === defaults.mode) ? defaults.mode! : 'draw';
const fonts = [
  ['caveat', 'Handwriting', 'Casual, upright, quick pen'],
  ['great-vibes', 'Formal script', 'Joined, sloping, swashed capitals'],
  ['dancing', 'Flowing', 'Lively, bouncing baseline'],
] as const;
const font = fonts.some(([f]) => f === defaults.font) ? defaults.font! : 'caveat';
---
<div id="sm-panel" class="sm-panel" data-mode={mode}>
  <div class="sm-form">
    <div class="field-row sm-top">
      <div class="segmented" role="radiogroup" aria-label="How to make the signature">
        {modes.map(([value, label]) => <label><input type="radio" name="sm-mode" value={value} checked={mode === value} /><span>{label}</span></label>)}
      </div>
      <div class="field-row">
        <label class="small" for="sm-ink">Ink</label>
        <select id="sm-ink" aria-label="Ink colour">
          <option value="#111111">Black</option>
          <option value="#1a3f8f">Blue</option>
          <option value="#5a2d0c">Brown</option>
        </select>
      </div>
      <div class="field-row">
        <label class="small" for="sm-out">Saved image</label>
        <select id="sm-out">
          <option value="600">Small, 600 px wide</option>
          <option value="1200" selected>Medium, 1200 px wide</option>
          <option value="2400">Large, 2400 px wide</option>
        </select>
      </div>
    </div>

    <div id="sm-draw" class="sm-mode" hidden={mode !== 'draw'}>
      <canvas id="sm-pad" class="sig-pad" width="900" height="300" aria-label="Signature drawing area. Draw with your mouse, pen or finger."></canvas>
      <div class="field-row sm-pad-row">
        <span class="muted small">Sign above with a mouse, pen or finger. Everything stays in this tab.</span>
      </div>
      <div class="field-row sm-pad-row">
        <label class="small" for="sm-width">Pen</label>
        <select id="sm-width">
          <option value="3">Thin</option>
          <option value="5" selected>Medium</option>
          <option value="8">Bold</option>
        </select>
        <label class="check small"><input type="checkbox" id="sm-smooth" checked /> Smooth lines</label>
        <button class="btn btn-sm btn-ghost" type="button" id="sm-undo" disabled>Undo</button>
        <button class="btn btn-sm btn-ghost" type="button" id="sm-clear" disabled>Clear</button>
      </div>
    </div>

    <div id="sm-type" class="sm-mode" hidden={mode !== 'type'}>
      <div class="field">
        <label for="sm-text">Your name</label>
        <input type="text" id="sm-text" maxlength="40" autocomplete="name" placeholder="Type your name" />
      </div>
      <div class="sm-tiles" role="radiogroup" aria-label="Style">
        {fonts.map(([value, label, note]) => (
          <label class="sm-tile">
            <input type="radio" name="sm-font" value={value} checked={font === value} />
            <span class="sm-tile-body">
              <span class="sm-tile-label">{label}</span>
              <span class={`sm-tile-preview sm-font-${value}`} data-font={value}>Your name</span>
              <span class="muted small">{note}</span>
            </span>
          </label>
        ))}
      </div>
    </div>

    <div id="sm-photo" class="sm-mode" hidden={mode !== 'photo'}>
      <div id="sm-photo-drop" class="sm-photo-drop" tabindex="-1">
        <p class="sm-photo-prompt">Drop a photo of your signature here, or choose one</p>
        <button class="btn" type="button" id="sm-choose">Choose a photo</button>
        <input type="file" id="sm-file" accept="image/*,.heic,.heif" hidden />
      </div>
      <div class="field">
        <label for="sm-strength">Ink strength</label>
        <input type="range" id="sm-strength" min="0" max="100" step="1" value="50" />
        <p class="muted small sm-hint">Raise it for pale ink; lower it if paper texture shows.</p>
      </div>
      <p class="muted small sm-hint"><a href="/tools/crop-image">Crop the photo first</a> if it shows printed lines or other writing: anything dark is kept.</p>
    </div>
  </div>

  <div class="sm-result">
    <div class="sm-frame" id="sm-frame" data-state="empty">
      <canvas id="sm-canvas" width="600" height="200" role="img" aria-label="Your signature on a transparent background"></canvas>
      <p class="sm-empty" id="sm-empty">Your signature will appear here on a transparent background.</p>
    </div>
    <p class="muted small sm-caption">Preview on a checkerboard: the checks show where the image is transparent.</p>
    <p class="muted small sm-info" id="sm-info" aria-live="polite"></p>
    <div class="sm-actions">
      <button type="button" class="btn btn-primary" id="sm-png" disabled>Download PNG</button>
      <button type="button" class="btn" id="sm-svg" disabled>Download SVG</button>
      <button type="button" class="btn" id="sm-copy" disabled>Copy image</button>
      <button type="button" class="btn" id="sm-signpdf" disabled>Use in Sign PDF</button>
    </div>
    <p class="small sm-status" id="sm-status" role="status" aria-live="polite" hidden></p>
  </div>
</div>
<style is:global>
  .tool-panel:has(#sm-panel) #drop,
  .tool-panel:has(#sm-panel) .run-dock,
  .tool-panel:has(#sm-panel) #file-list { display: none; }
  .sm-panel { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 420px); gap: 28px; align-items: start; }
  .sm-form { display: grid; gap: 16px; min-width: 0; }
  .sm-top { justify-content: space-between; }
  .sm-mode { display: grid; gap: 12px; }
  .sm-mode[hidden] { display: none; }
  .sm-pad-row { gap: 10px; }
  .sm-form input[type='text'] { width: 100%; min-width: 0; }
  .sm-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }
  .sm-tile { display: block; margin: 0; cursor: pointer; }
  .sm-tile input { position: absolute; opacity: 0; pointer-events: none; }
  .sm-tile-body { display: grid; gap: 4px; padding: 10px 12px; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); background: #fdfdfa; min-width: 0; }
  .sm-tile input:checked + .sm-tile-body { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent); }
  .sm-tile input:focus-visible + .sm-tile-body { outline: 2px solid var(--accent); outline-offset: 2px; }
  .sm-tile-label { font-size: 13px; font-weight: 650; color: #3d4349; }
  .sm-tile-preview { font-size: 30px; line-height: 1.3; color: #1b1f23; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sm-font-caveat { font-family: Caveat, 'Segoe Script', 'Bradley Hand', cursive; font-weight: 500; }
  .sm-font-great-vibes { font-family: 'Great Vibes', 'Segoe Script', 'Brush Script MT', cursive; font-weight: 400; }
  .sm-font-dancing { font-family: 'Dancing Script', 'Segoe Script', 'Brush Script MT', cursive; font-weight: 500; }
  .sm-photo-drop { display: grid; justify-items: center; gap: 12px; padding: 28px 16px; border: 2px dashed var(--line-strong); border-radius: var(--radius); text-align: center; background: var(--surface); }
  .sm-photo-drop.is-over { border-color: var(--accent); background: var(--accent-soft); }
  .sm-photo-prompt { margin: 0; font-weight: 600; }
  .sm-hint { margin: 0; }
  .sm-result { display: grid; gap: 10px; position: sticky; top: 84px; min-width: 0; }
  .sm-frame { position: relative; min-height: 140px; border: 1px solid var(--line); border-radius: var(--radius); display: grid; place-items: center; padding: 14px; overflow: hidden;
    background: repeating-conic-gradient(var(--surface-2) 0 25%, var(--surface) 0 50%) 50% / 16px 16px; }
  .sm-frame canvas { max-width: 100%; height: auto; }
  .sm-frame[data-state='empty'] canvas { display: none; }
  .sm-frame:not([data-state='empty']) .sm-empty { display: none; }
  .sm-empty { margin: 0; padding: 24px; text-align: center; color: var(--muted); }
  .sm-caption, .sm-info { margin: 0; overflow-wrap: anywhere; }
  .sm-info.is-warn { color: var(--warn); font-weight: 600; }
  .sm-status { margin: 0; }
  .sm-status.is-warn { color: var(--warn); font-weight: 600; }
  .sm-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  @media (max-width: 720px) {
    .sm-panel { grid-template-columns: minmax(0, 1fr); }
    .sm-result { position: static; }
  }
</style>
