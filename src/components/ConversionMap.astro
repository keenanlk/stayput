---
// Decorative map for the home page's "Popular conversions" column: common source
// formats on the left, targets on the right, all wired through "This tab".
const rows = [30, 100, 170, 240, 310];
const from = ['HEIC', 'WebP', 'JPG', 'MOV', 'MP4'];
const to = ['JPG', 'PNG', 'PDF', 'GIF', 'MP3'];
const cycle = 10; // seconds; one file crosses every 2s
const tripPath = (y: number) => `M64 ${y}C94 ${y} 94 170 124 170H236C266 170 266 ${y} 296 ${y}`;
---
<svg class="conv-map" viewBox="0 0 360 340" width="360" height="340" aria-hidden="true" focusable="false">
  {rows.map((y) => (
    <>
      <path class="cm-wire" d={`M64 ${y}C94 ${y} 94 170 124 170`} />
      <path class="cm-wire" d={`M236 170C266 170 266 ${y} 296 ${y}`} />
    </>
  ))}
  {rows.map((y, i) => [[0, from[i]], [296, to[i]]].map(([x, label]) => (
    <g class="cm-file">
      <path d={`M${+x + 0.75} ${y - 21.25}h51.5l11 11v31.5h-62.5z`} />
      <path class="cm-fold" d={`M${+x + 52.25} ${y - 21.25}v11h11`} />
      <text x={+x + 30} y={y + 5}>{label}</text>
    </g>
  )))}
  <g class="cm-tab">
    <rect x="124.75" y="120.75" width="110.5" height="98.5" rx="10" />
    <path d="M125 140h110" />
    <circle cx="138" cy="130.5" r="2.5" /><circle cx="147" cy="130.5" r="2.5" /><circle cx="156" cy="130.5" r="2.5" />
    <text class="cm-tab-name" x="180" y="188">This tab</text>
    <text class="cm-tab-sub" x="180" y="206">0 uploads</text>
  </g>
  <g class="cm-pulses">
    {rows.map((y, i) => (
      <circle r="4" opacity="0">
        <animateMotion dur={`${cycle}s`} begin={`${i * 2}s`} repeatCount="indefinite" path={tripPath(y)} calcMode="linear" keyPoints="0;1;1" keyTimes="0;0.16;1" />
        <animate attributeName="opacity" dur={`${cycle}s`} begin={`${i * 2}s`} repeatCount="indefinite" values="0;1;1;0;0" keyTimes="0;0.02;0.15;0.17;1" />
      </circle>
    ))}
  </g>
</svg>
