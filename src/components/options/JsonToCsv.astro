---
/**
 * Option controls for JSON ↔ CSV. Groups are shown for the direction in use (see tools/json-to-csv.ts).
 * defaults.start is the direction shown before any data is given; the radio stays on "Pick from my data".
 */
interface Props { defaults?: Record<string, string> }
const { defaults = {} } = Astro.props;
// 'txt-to-csv' and 'csv-to-txt' start on Change delimiter with their own input and output delimiter.
const start = defaults.start === 'csv-to-json' ? 'csv-to-json' : defaults.start === 'txt-to-csv' || defaults.start === 'csv-to-txt' ? 'delimited' : 'json-to-csv';
const toTxt = defaults.start === 'csv-to-txt';
---
<div class="field wide">
  <label>Direction</label>
  <div class="segmented" role="radiogroup" aria-label="Direction">
    <label><input type="radio" name="direction" value="auto" checked /><span>Pick from my data</span></label>
    <label><input type="radio" name="direction" value="json-to-csv" /><span>JSON to CSV</span></label>
    <label><input type="radio" name="direction" value="csv-to-json" /><span>CSV to JSON</span></label>
    <label><input type="radio" name="direction" value="delimited" /><span>Change delimiter</span></label>
  </div>
</div>
<div class="jc-group" id="jc-to-csv" data-start={start} hidden={start !== 'json-to-csv'}>
  <div class="field">
    <label for="jc-out-delimiter">Delimiter</label>
    <select id="jc-out-delimiter">
      <option value="," selected>Comma</option>
      <option value=";">Semicolon</option>
      <option value="&#9;">Tab</option>
      <option value="|">Pipe</option>
    </select>
  </div>
  <div class="field">
    <label for="jc-eol">Line ending</label>
    <select id="jc-eol">
      <option value="crlf" selected>CRLF (Windows, Excel)</option>
      <option value="lf">LF (Mac, Linux)</option>
    </select>
  </div>
  <div class="field wide">
    <label class="check"><input type="checkbox" id="jc-flatten" checked /> Flatten nested objects</label>
    <label class="check"><input type="checkbox" id="jc-join" /> Join arrays with ;</label>
    <label class="check"><input type="checkbox" id="jc-bom" checked /> UTF-8 with BOM (for Excel)</label>
  </div>
  <div class="field" id="jc-which-field" hidden>
    <label for="jc-which">Which list</label>
    <select id="jc-which"></select>
  </div>
</div>
<div class="jc-group" id="jc-to-json" hidden={start !== 'csv-to-json'}>
  <div class="field">
    <label for="jc-in-delimiter">Delimiter</label>
    <select id="jc-in-delimiter">
      <option value="auto" selected>Detect it</option>
      <option value=",">Comma</option>
      <option value=";">Semicolon</option>
      <option value="&#9;">Tab</option>
      <option value="|">Pipe</option>
    </select>
  </div>
  <div class="field">
    <label for="jc-pretty">Output</label>
    <select id="jc-pretty">
      <option value="pretty" selected>Pretty (2 spaces)</option>
      <option value="min">Minified</option>
    </select>
  </div>
  <div class="field wide">
    <label class="check"><input type="checkbox" id="jc-headers" checked /> First row is headers (off gives an array of arrays)</label>
    <label class="check"><input type="checkbox" id="jc-types" /> Detect types (numbers, true, false, null)</label>
  </div>
</div>
<div class="jc-group" id="jc-delimited" hidden={start !== 'delimited'}>
  <div class="field">
    <label for="jc-d-from">Cells in your text are separated by</label>
    <select id="jc-d-from">
      <option value="auto" selected>Detect it</option>
      <option value="&#9;">Tab</option>
      <option value=";">Semicolon</option>
      <option value="|">Pipe</option>
      <option value=",">Comma</option>
      <option value="spaces">Runs of 2 or more spaces</option>
      <option value="whitespace">Any spaces or tabs</option>
    </select>
  </div>
  <div class="field">
    <label for="jc-d-to">Write the cells separated by</label>
    <select id="jc-d-to">
      <option value="," selected={!toTxt}>Comma (.csv)</option>
      <option value="&#9;" selected={toTxt}>Tab (.txt)</option>
      <option value="|">Pipe (.txt)</option>
      <option value=";">Semicolon (.txt)</option>
      <option value="padded">Spaces, padded to line up (.txt)</option>
    </select>
  </div>
  <div class="field">
    <label for="jc-d-eol">Line ending</label>
    <select id="jc-d-eol">
      <option value="crlf" selected>CRLF (Windows, Excel)</option>
      <option value="lf">LF (Mac, Linux)</option>
    </select>
  </div>
  <div class="field wide">
    <label class="check"><input type="checkbox" id="jc-d-bom" checked={!toTxt} /> UTF-8 with BOM (for Excel)</label>
  </div>
</div>
