---
/** Option controls for repeat video, shared by the tool page and its landing pages. */
interface Props { defaults?: Record<string, string> }
const { defaults = {} } = Astro.props;
const by = defaults.by ?? 'count';
---
<div class="field">
  <label>Repeat by</label>
  <div class="segmented" role="radiogroup" aria-label="Repeat by">
    <label><input type="radio" name="by" value="count" checked={by === 'count'} /><span>Number of times</span></label>
    <label><input type="radio" name="by" value="length" checked={by === 'length'} /><span>Length</span></label>
  </div>
</div>
<div class="field" id="loop-count-field">
  <label for="loop-count">Times to play the clip (2 to 50)</label>
  <input type="number" id="loop-count" min="2" max="50" step="1" value={defaults.count ?? '5'} />
</div>
<div class="field" id="loop-length-field" hidden>
  <label for="loop-minutes">Make it at least this long (minutes)</label>
  <input type="number" id="loop-minutes" min="0.1" step="0.5" value={defaults.minutes ?? '10'} />
</div>
<div class="field">
  <label class="check"><input type="checkbox" id="mute" checked={defaults.mute === 'true'} /> Remove the sound</label>
</div>
