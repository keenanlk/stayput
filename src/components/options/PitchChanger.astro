---
/** Option controls for the pitch and speed changer, shared by the tool page and its landing pages. */
interface Props { defaults?: Record<string, string> }
const { defaults = {} } = Astro.props;
const semitones = defaults.semitones ?? '0';
const speed = defaults.speed ?? '1';
const format = defaults.format ?? 'same';
const speeds = ['0.5', '0.6', '0.7', '0.75', '0.8', '0.85', '0.9', '0.95', '1', '1.05', '1.1', '1.15', '1.2', '1.25', '1.3', '1.4', '1.5', '1.75', '2'];
const formats = [
  ['same', 'Same as the original'],
  ['mp3', 'MP3'],
  ['wav', 'WAV'],
  ['flac', 'FLAC'],
  ['m4a', 'M4A (AAC)'],
  ['ogg', 'OGG (Opus)'],
] as const;
---
<div class="field">
  <label for="semitones">Pitch <output id="semitones-out">{Number(semitones) > 0 ? `+${semitones}` : semitones} semitones</output></label>
  <input type="range" id="semitones" min="-12" max="12" step="1" value={semitones} />
  <p class="muted small">12 semitones is one octave. The length stays the same.</p>
</div>
<div class="field">
  <label for="speed">Speed</label>
  <select id="speed">
    {speeds.map((s) => <option value={s} selected={s === speed}>{s === '1' ? '1× (unchanged)' : `${s}×`}</option>)}
  </select>
  <label class="check"><input type="checkbox" id="tape" checked={defaults.tape === 'true'} /> Let the pitch follow the speed, like a record played fast or slow</label>
</div>
<div class="field">
  <label for="format">Save as</label>
  <select id="format">
    {formats.map(([v, l]) => <option value={v} selected={v === format}>{l}</option>)}
  </select>
</div>
