---
/** Option controls for resizing GIFs, shared by the tool page and any landing pages. */
interface Props { defaults?: Record<string, string> }
const { defaults = {} } = Astro.props;
const by = defaults.by ?? 'percent';
const percent = defaults.percent ?? '50';
const percents = ['25', '50', '75', '150', '200'];
const quick = [
  ['100×100', '100', '100'],
  ['128×128', '128', '128'],
  ['256×256', '256', '256'],
  ['320×320', '320', '320'],
  ['480 px wide', '480', ''],
  ['640 px wide', '640', ''],
] as const;
---
<div class="field">
  <label>Resize by</label>
  <div class="segmented" role="radiogroup" aria-label="Resize by">
    <label><input type="radio" name="by" value="percent" checked={by === 'percent'} /><span>Percent</span></label>
    <label><input type="radio" name="by" value="pixels" checked={by === 'pixels'} /><span>Pixels</span></label>
  </div>
</div>
<div id="by-percent">
  <div class="field-row">
    <div class="field">
      <label for="percent">Size</label>
      <select id="percent">
        {percents.map((p) => <option value={p} selected={p === percent}>{p}%</option>)}
      </select>
    </div>
    <div class="field">
      <label for="percent-custom">Or a number (5 to 400)</label>
      <input type="number" id="percent-custom" min="5" max="400" step="1" inputmode="numeric" placeholder="%" />
    </div>
  </div>
</div>
<div id="by-pixels" hidden>
  <div class="field-row">
    <div class="field"><label for="width">Width (px)</label><input type="number" id="width" min="1" max="4096" step="1" inputmode="numeric" value={defaults.width ?? ''} /></div>
    <div class="field"><label for="height">Height (px)</label><input type="number" id="height" min="1" max="4096" step="1" inputmode="numeric" value={defaults.height ?? ''} /></div>
  </div>
  <div class="field">
    <label class="check"><input type="checkbox" id="keep" checked={defaults.keep !== 'false'} /> Keep proportions</label>
    <p class="muted small" id="keep-note">For several GIFs, the width is applied to each and the height follows its own ratio.</p>
  </div>
  <div class="field" id="fit-field" hidden>
    <label for="fit">If the shape changes</label>
    <select id="fit">
      <option value="stretch" selected>Stretch to fit</option>
      <option value="contain">Fit inside (transparent bars)</option>
      <option value="cover">Fill and crop</option>
    </select>
  </div>
  <div class="field">
    <label>Quick sizes</label>
    <div class="quick-sizes">
      {quick.map(([label, w, h]) => <button class="btn btn-sm btn-ghost" type="button" data-w={w} data-h={h}>{label}</button>)}
    </div>
  </div>
</div>
<style>
  .quick-sizes { display: flex; flex-wrap: wrap; gap: 6px; }
</style>
