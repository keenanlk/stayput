---
/** Option controls for Transcribe, shared by the tool page and its landing pages. */
interface Props { defaults?: Record<string, string> }
const { defaults = {} } = Astro.props;
const language = defaults.language ?? 'auto';
const task = defaults.task ?? 'transcribe';
const format = defaults.format ?? 'txt';
const languages = [
  ['auto', 'Detect automatically'],
  ['en', 'English'],
  ['es', 'Spanish'],
  ['fr', 'French'],
  ['de', 'German'],
  ['it', 'Italian'],
  ['pt', 'Portuguese'],
  ['nl', 'Dutch'],
  ['pl', 'Polish'],
  ['ru', 'Russian'],
  ['uk', 'Ukrainian'],
  ['tr', 'Turkish'],
  ['ar', 'Arabic'],
  ['hi', 'Hindi'],
  ['ja', 'Japanese'],
  ['ko', 'Korean'],
  ['zh', 'Chinese'],
] as const;
const formats = [
  ['txt', 'Text (.txt), in paragraphs'],
  ['srt', 'Subtitles (.srt)'],
  ['vtt', 'Web captions (.vtt)'],
] as const;
---
<div class="field">
  <label for="language">Spoken language</label>
  <select id="language">
    {languages.map(([v, l]) => <option value={v} selected={v === language}>{l}</option>)}
  </select>
</div>
<div class="field">
  <label for="format">Save as</label>
  <select id="format">
    {formats.map(([v, l]) => <option value={v} selected={v === format}>{l}</option>)}
  </select>
</div>
<div class="field wide">
  <label>Output language</label>
  <div class="segmented" role="radiogroup" aria-label="Output language">
    <label><input type="radio" name="task" value="transcribe" checked={task === 'transcribe'} /><span>Same as spoken</span></label>
    <label><input type="radio" name="task" value="translate" checked={task === 'translate'} /><span>Translate to English</span></label>
  </div>
</div>
<p class="muted small">The first run downloads the speech model (76 MB) to this browser; after that it works offline. Expect about two to three minutes of work for every ten minutes of sound on a laptop, longer on a phone.</p>
