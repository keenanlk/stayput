---
/** Option controls for the colour picker, shared by the tool page and its landing pages. */
interface Props { defaults?: Record<string, string> }
const { defaults = {} } = Astro.props;
const size = defaults.colors ?? '6';
---
<div class="field">
  <label for="colors">Main colours to find</label>
  <select id="colors">
    {['4', '6', '8', '10', '12'].map((v) => <option value={v} selected={v === size}>{v}</option>)}
  </select>
</div>
<p class="muted small">Save palette downloads the main colours and the ones you picked as an image, with every HEX code ready to copy.</p>
