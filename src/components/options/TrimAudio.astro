---
/** Option controls for trimming audio, shared by the tool page and its landing pages. */
interface Props { defaults?: Record<string, string> }
const { defaults = {} } = Astro.props;
const format = defaults.format ?? 'mp3';
---
<div class="field-row wide au-trim">
  <div class="field">
    <label for="au-start">Start (seconds)</label>
    <div class="au-time"><input type="number" id="au-start" min="0" step="0.1" value="0" inputmode="decimal" /><button class="btn btn-sm btn-ghost" type="button" id="au-set-start">Set start</button></div>
  </div>
  <div class="field">
    <label for="au-end">End (seconds)</label>
    <div class="au-time"><input type="number" id="au-end" min="0" step="0.1" value="0" inputmode="decimal" /><button class="btn btn-sm btn-ghost" type="button" id="au-set-end">Set end</button></div>
  </div>
</div>
<div class="field">
  <label class="check"><input type="checkbox" id="fade-in" checked={defaults['fade-in'] === 'true'} /> Fade in at the start</label>
  <label class="check"><input type="checkbox" id="fade-out" checked={defaults['fade-out'] === 'true'} /> Fade out at the end</label>
</div>
<div class="field">
  <label for="format">Save as</label>
  <select id="format">
    <option value="mp3" selected={format === 'mp3'}>MP3 (plays everywhere)</option>
    <option value="wav" selected={format === 'wav'}>WAV (no quality loss, larger)</option>
  </select>
</div>
<p class="muted small au-estimate" id="au-estimate" aria-live="polite"></p>
<style is:global>
  .au-trim { align-items: end; }
  .au-trim .field { flex: 1 1 180px; }
  .au-time { display: flex; gap: 6px; }
  .au-time input { width: 100%; min-width: 0; }
  .au-time .btn { white-space: nowrap; }
  .au-estimate { margin: 0; grid-column: 1 / -1; }
  .au-estimate.is-over { color: var(--warn); font-weight: 600; }
</style>
