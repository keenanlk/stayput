---
/** Option controls for crop GIF, shared by the tool page and any landing pages. */
interface Props { defaults?: Record<string, string> }
const { defaults = {} } = Astro.props;
const aspect = defaults.aspect ?? 'free';
const colours = defaults.colours ?? 'light';
const aspects = [
  ['free', 'Free'],
  ['1:1', 'Square (1:1)'],
  ['4:5', 'Portrait (4:5)'],
  ['16:9', 'Widescreen (16:9)'],
  ['9:16', 'Vertical (9:16)'],
  ['4:3', 'Classic (4:3)'],
  ['original', 'Same as the GIF'],
] as const;
---
<div class="field">
  <label for="aspect">Shape</label>
  <select id="aspect">
    {aspects.map(([v, l]) => <option value={v} selected={v === aspect}>{l}</option>)}
  </select>
</div>
<div class="field-row wide crop-fields">
  <div class="field"><label for="crop-x">Left (px)</label><input type="number" id="crop-x" min="0" step="1" value="0" /></div>
  <div class="field"><label for="crop-y">Top (px)</label><input type="number" id="crop-y" min="0" step="1" value="0" /></div>
  <div class="field"><label for="crop-w">Width (px)</label><input type="number" id="crop-w" min="1" step="1" value="0" /></div>
  <div class="field"><label for="crop-h">Height (px)</label><input type="number" id="crop-h" min="1" step="1" value="0" /></div>
  <button class="btn btn-sm btn-ghost" type="button" id="crop-reset">Reset</button>
</div>
<div class="field">
  <label for="colours">Colours</label>
  <select id="colours">
    <option value="light" selected={colours === 'light'}>Keep all colours</option>
    <option value="medium" selected={colours === 'medium'}>Fewer colours (smaller file)</option>
  </select>
</div>
<p class="hint">Fewer colours can look a little grainy.</p>
