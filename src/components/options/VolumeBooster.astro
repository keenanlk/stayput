---
/** Option controls for the volume booster, shared by the tool page and its landing pages. */
interface Props { defaults?: Record<string, string> }
const { defaults = {} } = Astro.props;
const mode = defaults.mode ?? 'boost';
const db = defaults.db ?? '6';
const format = defaults.format ?? 'same';
const levels = [
  ['20', '+20 dB (very quiet recordings)'],
  ['15', '+15 dB'],
  ['10', '+10 dB (about twice as loud)'],
  ['6', '+6 dB (noticeably louder)'],
  ['3', '+3 dB (a little louder)'],
  ['-3', '−3 dB (a little quieter)'],
  ['-6', '−6 dB (noticeably quieter)'],
  ['-10', '−10 dB (about half as loud)'],
] as const;
const formats = [
  ['same', 'Same as the original'],
  ['mp3', 'MP3'],
  ['wav', 'WAV'],
  ['flac', 'FLAC'],
  ['m4a', 'M4A (AAC)'],
  ['ogg', 'OGG (Opus)'],
] as const;
---
<div class="field">
  <label>Change</label>
  <div class="segmented" role="radiogroup" aria-label="Change">
    <label><input type="radio" name="mode" value="boost" checked={mode === 'boost'} /><span>By an amount</span></label>
    <label><input type="radio" name="mode" value="normalize" checked={mode === 'normalize'} /><span>Normalize</span></label>
  </div>
  <p class="muted small" id="mode-note">{mode === 'normalize' ? 'Brings every file to the same, comfortable loudness, like a streaming app does.' : 'Peaks that would clip are gently turned down, so nothing distorts.'}</p>
</div>
<div class="field" id="db-field" hidden={mode === 'normalize'}>
  <label for="db">How much</label>
  <select id="db">
    {levels.map(([v, l]) => <option value={v} selected={v === db}>{l}</option>)}
  </select>
</div>
<div class="field" id="format-field">
  <label for="format">Save as</label>
  <select id="format">
    {formats.map(([v, l]) => <option value={v} selected={v === format}>{l}</option>)}
  </select>
  <p class="muted small">Videos keep their picture untouched and get the new sound.</p>
</div>
