---
/** Option controls for the image and PDF watermark tools and their landing pages. */
interface Props { defaults?: Record<string, string>; pdf?: boolean }
const { defaults = {}, pdf = false } = Astro.props;
const text = defaults.text ?? (pdf ? 'CONFIDENTIAL' : '© Your name');
const layout = defaults.layout ?? (pdf ? 'center' : 'corner');
const size = defaults.size ?? (pdf ? '7' : '4');
const opacity = defaults.opacity ?? (pdf ? '25' : '60');
const color = defaults.color ?? (pdf ? '#c0392b' : '#ffffff');
const format = defaults.format ?? 'keep';
const layouts = [
  ['center', 'Across the middle'],
  ['tiled', 'Repeated'],
  ['corner', 'Corner'],
] as const;
const formats = [
  ['keep', 'Same as original'],
  ['image/jpeg', 'JPG'],
  ['image/png', 'PNG'],
  ['image/webp', 'WebP'],
] as const;
---
<div class="field wide">
  <label for="wm-text">Watermark text</label>
  <input type="text" id="wm-text" value={text} maxlength="120" autocomplete="off" />
</div>
<div class="field wide">
  <label>Placement</label>
  <div class="segmented" role="radiogroup" aria-label="Placement">
    {layouts.map(([v, l]) => <label><input type="radio" name="layout" value={v} checked={v === layout} /><span>{l}</span></label>)}
  </div>
</div>
<div class="field">
  <label for="wm-size">Size <output id="wm-size-out">{size}</output></label>
  <input type="range" id="wm-size" min="1" max="10" value={size} />
</div>
<div class="field">
  <label for="wm-opacity">Opacity <output id="wm-opacity-out">{opacity}</output>%</label>
  <input type="range" id="wm-opacity" min="5" max="100" step="5" value={opacity} />
</div>
<div class="field">
  <label for="wm-color">Colour</label>
  <input type="color" id="wm-color" value={color} />
</div>
{!pdf && (
  <div class="field">
    <label for="format">Save as</label>
    <select id="format">
      {formats.map(([v, l]) => <option value={v} selected={v === format}>{l}</option>)}
    </select>
  </div>
)}
