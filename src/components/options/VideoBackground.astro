---
/** Option controls for Video background remover, shared by the tool page and its landing pages. */
interface Props { defaults?: Record<string, string> }
const { defaults = {} } = Astro.props;
const bg = defaults.bg ?? 'blur';
const strength = defaults.strength ?? '6';
const color = defaults.color ?? '#00b140';
const finder = defaults.finder ?? 'edges';
const size = defaults.size ?? 'full';
---
<div class="field">
  <label>New background</label>
  <div class="segmented" role="radiogroup" aria-label="New background">
    <label><input type="radio" name="bg" value="blur" checked={bg === 'blur'} /><span>Blur</span></label>
    <label><input type="radio" name="bg" value="color" checked={bg === 'color'} /><span>Colour</span></label>
    <label><input type="radio" name="bg" value="image" checked={bg === 'image'} /><span>Picture</span></label>
  </div>
</div>
<div class="field">
  <label>Person finder</label>
  <div class="segmented" role="radiogroup" aria-label="Person finder">
    <label><input type="radio" name="finder" value="edges" checked={finder === 'edges'} /><span>Better edges</span></label>
    <label><input type="radio" name="finder" value="fast" checked={finder === 'fast'} /><span>Fast</span></label>
  </div>
</div>
<div class="field">
  <label>Output size</label>
  <div class="segmented" role="radiogroup" aria-label="Output size">
    <label><input type="radio" name="size" value="full" checked={size === 'full'} /><span>Same as the video</span></label>
    <label><input type="radio" name="size" value="hd" checked={size === 'hd'} /><span>1080p</span></label>
  </div>
</div>
<div class="field" id="strength-field" hidden={bg !== 'blur'}>
  <label for="strength">Blur <output id="strength-out">{strength}</output></label>
  <input type="range" id="strength" min="1" max="10" step="1" value={strength} />
</div>
<div class="field" id="color-field" hidden={bg !== 'color'}>
  <label for="bg-color">Colour</label>
  <input type="color" id="bg-color" value={color} />
</div>
<p class="hint" id="image-hint" hidden={bg !== 'image'}>Drop a JPG or PNG with the video to fill the frame behind the person.</p>
<p class="hint">Made for people. Fast is rougher around hair and in dim light.</p>
<p class="hint" id="phone-fast-note" hidden>On a phone, Fast is chosen for you because Better edges is slower there. Choose Better edges for cleaner hair edges; Fast can find no one in dim light.</p>
<p class="hint" id="time-note">Can run slower than the video plays; the time left shows as it runs. Phones start on Fast.</p>
<p class="hint" id="phone-note" hidden>This clip is big for a phone. For a faster, steadier run, trim it first or use a 1080p copy.</p>
<p class="hint" id="size-note" hidden>This video is bigger than 1080p, so the output is set to 1080p on a phone: much quicker and a smaller file. Choose Same as the video to keep the size.</p>
