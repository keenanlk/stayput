---
/** Option controls for the background remover, shared by the tool page and its landing pages. */
interface Props { defaults?: Record<string, string> }
const { defaults = {} } = Astro.props;
const bg = defaults.bg ?? 'transparent';
const color = defaults['bg-color'] ?? '#ffffff';
const format = defaults.format ?? 'image/png';
const strength = defaults.strength ?? '5';
const keep = defaults.keep ?? '0';
const keeps = [
  ['-1', 'Less'],
  ['0', 'Normal'],
  ['1', 'More'],
] as const;
const backgrounds = [
  ['transparent', 'Transparent'],
  ['white', 'White'],
  ['color', 'Colour'],
  ['blur', 'Blur'],
] as const;
const formats = [
  ['image/png', 'PNG'],
  ['image/webp', 'WebP (smaller)'],
  ['image/jpeg', 'JPG (not for transparent)'],
] as const;
---
<div class="field wide">
  <label>New background</label>
  <div class="segmented" role="radiogroup" aria-label="New background">
    {backgrounds.map(([v, l]) => <label><input type="radio" name="bg" value={v} checked={v === bg} /><span>{l}</span></label>)}
  </div>
</div>
<div class="field" id="bg-color-field" hidden={bg !== 'color'}>
  <label for="bg-color">Background colour</label>
  <input type="color" id="bg-color" value={color} />
</div>
<div class="field" id="strength-field" hidden={bg !== 'blur'}>
  <label for="strength">Blur strength <output id="strength-out">{strength}</output></label>
  <input type="range" id="strength" min="1" max="10" value={strength} />
</div>
<div class="field">
  <label>Keep around the edges</label>
  <div class="segmented" role="radiogroup" aria-label="Keep around the edges">
    {keeps.map(([v, l]) => <label><input type="radio" name="keep" value={v} checked={v === keep} /><span>{l}</span></label>)}
  </div>
</div>
<div class="field">
  <label for="format">Save as</label>
  <select id="format">
    {formats.map(([v, l]) => <option value={v} selected={v === format}>{l}</option>)}
  </select>
</div>
<p class="field wide model-note" id="model-note">
  The first photo downloads the cut-out model (about 46 MB, once). After that it is cached and works offline. If part of the subject goes missing, try Keep more; if bits of background stay, try Keep less.
</p>

<style>
  .model-note {
    margin: 0;
    font-size: 14px;
    color: var(--ink-2);
  }
</style>
