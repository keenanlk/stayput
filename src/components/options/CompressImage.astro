---
/** Option controls for compress/resize, shared by the tool page and its landing pages. */
interface Props { defaults?: Record<string, string> }
const { defaults = {} } = Astro.props;
const mode = defaults['resize-mode'] ?? 'max';
const quality = defaults.quality ?? '80';
const format = defaults.format ?? 'keep';
const maxWidth = defaults['max-width'] ?? '2000';
const maxHeight = defaults['max-height'] ?? '2000';
const formats = [
  ['keep', 'Same as original'],
  ['image/jpeg', 'JPG'],
  ['image/webp', 'WebP (smallest)'],
  ['image/png', 'PNG (lossless)'],
] as const;
---
<div class="field wide">
  <label>Resize</label>
  <div class="segmented" role="radiogroup" aria-label="Resize mode">
    <label><input type="radio" name="resize-mode" value="max" checked={mode === 'max'} /><span>Limit dimensions</span></label>
    <label><input type="radio" name="resize-mode" value="percent" checked={mode === 'percent'} /><span>Percentage</span></label>
    <label><input type="radio" name="resize-mode" value="none" checked={mode === 'none'} /><span>Keep size</span></label>
  </div>
</div>
<div class="field-row wide" id="max-fields">
  <div class="field"><label for="max-width">Max width (px)</label><input type="number" id="max-width" min="1" step="1" value={maxWidth} /></div>
  <div class="field"><label for="max-height">Max height (px)</label><input type="number" id="max-height" min="1" step="1" value={maxHeight} /></div>
</div>
<div class="field" id="percent-field" hidden>
  <label for="percent">Scale <output id="percent-out">50%</output></label>
  <input type="range" id="percent" min="5" max="100" value="50" />
</div>
<div class="field">
  <label for="quality">Quality <output id="quality-out">{quality}</output></label>
  <input type="range" id="quality" min="30" max="100" value={quality} />
</div>
<div class="field">
  <label for="format">Output format</label>
  <select id="format">
    {formats.map(([v, l]) => <option value={v} selected={v === format}>{l}</option>)}
  </select>
</div>
