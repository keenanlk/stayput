---
/** Option controls for the archive extractor, shared by the tool page and its landing pages. */
import OptionDetails from '../OptionDetails.astro';
---
<div class="field">
  <label for="password">Password <span class="muted">(only for locked archives)</span></label>
  <input type="password" id="password" autocomplete="off" spellcheck="false" />
</div>
<OptionDetails>
  <p>Opens ZIP, RAR (including RAR5), 7z, TAR, TAR.GZ, TGZ, TAR.BZ2, TAR.XZ, ISO and CAB. Each file inside is listed to download on its own, or all together as one ZIP.</p>
</OptionDetails>
