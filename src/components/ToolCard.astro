---
import Icon from './Icon.astro';
import { toolPath, type Tool } from '../data/tools';
import { presetBySlug } from '../data/presets';
import { pairBySlug } from '../data/pairs';
interface Props { tool: Tool; compact?: boolean }
const { tool, compact = false } = Astro.props;
const icons: Record<string, string> = {
  'heic-to-jpg': 'image', 'convert-image': 'convert', 'compress-image': 'resize', 'strip-exif': 'eye', 'exif-viewer': 'search',
  'merge-pdf': 'merge', 'split-pdf': 'split', 'compress-pdf': 'compress', 'rotate-pdf': 'rotate',
  'image-to-pdf': 'pdf', 'pdf-to-image': 'image',
  'reorder-pdf': 'grid', 'sign-pdf': 'pen', 'signature-maker': 'pen', 'fill-pdf-form': 'text', 'pdf-page-numbers': 'hash', 'pdf-to-word': 'convert',
  'crop-image': 'crop', 'favicon-generator': 'image', 'blur-image': 'blur', 'rotate-image': 'rotate',
  'video-to-gif': 'video', 'video-to-mp3': 'audio', 'gif-to-mp4': 'film', 'gif-to-animated-png': 'film', 'compress-video': 'shrink', 'video-to-mp4': 'video', 'video-to-mov': 'video', 'compress-png': 'compress', 'compress-gif': 'compress', 'resize-gif': 'resize', 'crop-gif': 'crop', 'gif-speed': 'speed', 'merge-gifs': 'merge', 'add-text-to-gif': 'text', 'trim-video': 'scissors', 'mute-video': 'mute', 'resize-video': 'resize', 'rotate-video': 'rotate', 'crop-video': 'crop', 'video-speed': 'speed', 'merge-videos': 'merge', 'add-audio-to-video': 'audio', 'reverse-video': 'back', 'video-to-jpg': 'image', 'trim-audio': 'scissors', 'audio-splitter': 'scissors', 'tuner': 'tuner', 'resize-pdf': 'resize', 'flatten-pdf': 'pdf', 'gif-maker': 'film', 'image-to-svg': 'pen', 'remove-silence': 'scissors', 'blur-face-video': 'blur', 'metronome': 'metronome', 'pitch-changer': 'speed', 'bpm-key-finder': 'metronome', 'extract-pdf-images': 'image', 'collage-maker': 'merge', 'split-image': 'grid', 'add-text-to-image': 'text', 'compress-audio': 'compress', 'audio-to-video': 'film', 'qr-code-generator': 'qr', 'qr-code-scanner': 'qr', 'barcode-generator': 'barcode', 'screen-recorder': 'record', 'webcam-test': 'video', 'voice-recorder': 'mic', 'mic-test': 'mic', 'speaker-test': 'volume', 'merge-audio': 'merge', 'volume-booster': 'volume', 'remove-noise': 'mic', 'audio-converter': 'audio', 'image-to-text': 'text', 'color-picker': 'color', 'remove-background': 'cutout', 'passport-photo': 'portrait', 'watermark-image': 'stamp', 'watermark-pdf': 'stamp', 'remove-pdf-metadata': 'shield', 'sticker-maker': 'sticker', 'profile-picture-maker': 'portrait', 'redact-pdf': 'redact', 'crop-pdf': 'crop', 'grayscale-pdf': 'contrast', 'black-and-white-image': 'contrast', 'upscale-image': 'resize', 'transcribe': 'text', 'remove-object': 'eraser', 'adjust-image': 'sliders', 'emote-resizer': 'smile', 'pixel-art-converter': 'grid', 'photo-to-sketch': 'pen', 'add-border-to-image': 'frame', 'add-subtitles-to-video': 'video', 'vocal-remover': 'mic', 'video-background-remover': 'cutout', 'ocr-pdf': 'text', 'document-scanner': 'crop', 'epub-to-pdf': 'convert', 'text-to-pdf': 'text', 'pdf-to-epub': 'convert', 'archive-extractor': 'merge', 'create-zip': 'merge', 'file-checksum': 'hash', 'json-to-csv': 'convert', 'subtitle-converter': 'text',
};
// Preset and format-pair landing pages borrow their base tool's icon.
const icon = icons[tool.slug] ?? icons[presetBySlug(tool.slug)?.base ?? ''] ?? (pairBySlug(tool.slug) ? 'convert' : 'pdf');
---
{compact ? (
  <a class="tool-card compact" href={toolPath(tool)} title={tool.tagline}>
    <div class="icon"><Icon name={icon} /></div>
    <h3>{tool.name}</h3>
  </a>
) : (
  <a class="tool-card" href={toolPath(tool)}>
    <div class="icon"><Icon name={icon} /></div>
    <h3>{tool.name}</h3>
    <p>{tool.tagline}</p>
    <Icon name="arrow" class="go" />
  </a>
)}
