---
import Icon from './Icon.astro';
import { toolPath, type Tool } from '../data/tools';
import { presetBySlug } from '../data/presets';
import { pairBySlug } from '../data/pairs';
interface Props { tool: Tool }
const { tool } = Astro.props;
const icons: Record<string, string> = {
  'heic-to-jpg': 'image', 'convert-image': 'convert', 'compress-image': 'resize', 'strip-exif': 'eye', 'exif-viewer': 'search',
  'merge-pdf': 'merge', 'split-pdf': 'split', 'compress-pdf': 'compress', 'rotate-pdf': 'rotate',
  'image-to-pdf': 'pdf', 'pdf-to-image': 'image',
  'reorder-pdf': 'grid', 'sign-pdf': 'pen', 'pdf-page-numbers': 'hash', 'pdf-to-word': 'convert',
  'crop-image': 'crop', 'favicon-generator': 'image', 'blur-image': 'blur', 'rotate-image': 'rotate',
  'video-to-gif': 'video', 'video-to-mp3': 'audio', 'gif-to-mp4': 'film', 'compress-video': 'shrink', 'video-to-mp4': 'video', 'compress-png': 'compress', 'compress-gif': 'compress', 'trim-video': 'scissors', 'mute-video': 'mute', 'resize-video': 'resize', 'rotate-video': 'rotate', 'crop-video': 'crop', 'video-speed': 'speed', 'merge-videos': 'merge', 'add-audio-to-video': 'audio', 'reverse-video': 'back', 'video-to-jpg': 'image', 'trim-audio': 'scissors', 'merge-audio': 'merge', 'volume-booster': 'volume', 'audio-converter': 'audio', 'image-to-text': 'text', 'color-picker': 'color', 'remove-background': 'cutout', 'passport-photo': 'portrait', 'watermark-image': 'stamp', 'watermark-pdf': 'stamp', 'remove-pdf-metadata': 'shield', 'sticker-maker': 'sticker', 'profile-picture-maker': 'portrait', 'redact-pdf': 'redact', 'crop-pdf': 'crop',
};
// Preset and format-pair landing pages borrow their base tool's icon.
const icon = icons[tool.slug] ?? icons[presetBySlug(tool.slug)?.base ?? ''] ?? (pairBySlug(tool.slug) ? 'convert' : 'pdf');
---
<a class="tool-card" href={toolPath(tool)}>
  <div class="icon"><Icon name={icon} /></div>
  <h3>{tool.name}</h3>
  <p>{tool.tagline}</p>
  <Icon name="arrow" class="go" />
</a>
