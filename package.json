{
  "name": "stayput",
  "version": "0.1.0",
  "description": "Free, open-source file tools that run entirely in your browser. Nothing is uploaded.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "homepage": "https://stayput.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/keenanlk/stayput.git"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "check-links": "node scripts/check-links.mjs",
    "live-caption-matrix": "node scripts/live-caption-matrix.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "playwright test",
    "launch-assets": "node scripts/make-launch-samples.mjs && python3 scripts/make-launch-samples.py && node scripts/make-launch-assets.mjs && python3 scripts/make-launch-gif.py"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@huggingface/transformers": "4.3.0",
    "@jsquash/avif": "2.1.1",
    "@jsquash/jxl": "1.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@neslinesli93/qpdf-wasm": "0.3.0",
    "@noble/ciphers": "2.4.0",
    "@shiguredo/rnnoise-wasm": "2025.1.5",
    "@tesseract.js-data/eng": "1.0.0",
    "ag-psd": "31.0.3",
    "astro": "7.3.5",
    "fflate": "0.8.3",
    "gifenc": "1.0.3",
    "gifuct-js": "2.1.2",
    "hash-wasm": "4.12.0",
    "heic-to": "1.6.5",
    "imagetracerjs": "1.2.6",
    "libarchive.js": "2.0.2",
    "mediabunny": "1.61.0",
    "mp4-muxer": "5.2.2",
    "onnxruntime-web": "1.30.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pdfmake": "0.3.11",
    "tesseract.js": "7.0.0",
    "upng-js": "2.1.0",
    "utif2": "4.1.0",
    "wasm-media-encoders": "0.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/upng-js": "2.1.5",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@huggingface/transformers": {
      "onnxruntime-node": "file:./stubs/empty",
      "sharp": "file:./stubs/empty",
      "onnxruntime-web": "$onnxruntime-web"
    }
  }
}
